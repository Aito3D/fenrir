[
 {
  "id": "ftree-openapi",
  "cmd": "PYTHONHASHSEED=0 PYTHONPATH=. ./venv/bin/python3 tools/probe_ftree_openapi.py 2>/dev/null",
  "timeout": 300,
  "scrub": [],
  "files": []
 },
 {
  "id": "ftree-rules",
  "cmd": "PYTHONHASHSEED=0 PYTHONPATH=. ./venv/bin/python3 tools/probe_ftree_rules.py 2>/dev/null",
  "timeout": 300,
  "scrub": [],
  "files": []
 },
 {
  "id": "ftree-http",
  "cmd": "PYTHONHASHSEED=0 PYTHONPATH=. ./venv/bin/python3 tools/probe_ftree_api.py 2>/dev/null",
  "timeout": 600,
  "scrub": ["\\d{4}-\\d{2}-\\d{2}[T ][0-9:.]+"],
  "files": []
 },
 {
  "id": "ftree-surface-py",
  "cmd": "for w in routes callables schemas ddl permissions; do echo \"=== $w\"; PYTHONHASHSEED=0 ./venv/bin/python3 tools/probe_ftree_surface.py $w 2>/dev/null; done",
  "timeout": 600,
  "scrub": [],
  "files": []
 },
 {
  "id": "ftree-frontend-pure",
  "cmd": "mkdir -p /tmp/fenrir-refactor-ftree-probe && frontend/node_modules/.bin/rolldown tools/probe_ftree_frontend_entry.ts --format cjs --file /tmp/fenrir-refactor-ftree-probe/ftreeFrontend.cjs >/dev/null 2>&1 && node tools/probe_ftree_frontend.cjs",
  "timeout": 300,
  "scrub": [],
  "files": []
 },
 {
  "id": "ftree-i18n",
  "cmd": "LC_ALL=C node tools/probe_ftree_i18n.cjs",
  "timeout": 300,
  "scrub": [],
  "files": []
 },
 {
  "id": "ftree-api-client",
  "cmd": "LC_ALL=C awk -f tools/probe_ftree_client.awk frontend/src/api/client.ts",
  "timeout": 60,
  "scrub": [],
  "files": []
 }
]
