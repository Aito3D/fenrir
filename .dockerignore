# Git
# Exclude all .git contents EXCEPT HEAD. HEAD is a tiny text file (under
# 100 bytes) containing e.g. `ref: refs/heads/dev`, which the Dockerfile
# copies into the image so detect_current_branch() in spoolbuddy_ssh.py
# can report the correct branch for SpoolBuddy remote updates. Without
# this, the production image has no git metadata at all and always falls
# back to "main" regardless of which branch the operator built from.
.git/*
!.git/HEAD
.gitignore

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
ENV/
env/
.env
*.egg-info/
.eggs/
dist/
build/

# Node
frontend/node_modules/
frontend/.npm

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/

# Logs and data (will be mounted as volumes)
logs/
data/
*.log
*.db

# Build artifacts
static/

# Documentation
docs/
*.md
!requirements.txt

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# ---------------------------------------------------------------------------
# Local-only runtime state
# ---------------------------------------------------------------------------
# None of these exist on a CI checkout, so this section changes nothing about
# the images GitHub Actions builds. It matters for `docker build` / test_docker.sh
# on a developer machine, where the build context is whatever the working tree
# happens to hold: `archive/` alone measured 9.4 GB on this checkout, and every
# byte of it was being packed and streamed to the daemon before the first layer
# could start. All of these are gitignored runtime directories that no COPY in
# either Dockerfile references.
archive/
firmware/
virtual_printer/
/data/
.cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
screenshots/
debug_logs/
db_backup/
support-packages/
backups/
advertisements/
security/
spoolbuddy/ssh/
frontend/coverage/
node_modules/

# SQLite sidecar files. `*.db` above already covers the database itself; the
# write-ahead log is a separate file and is routinely larger than the schema.
*.db-wal
*.db-shm
*.db-journal

# Secrets that live at the repo root in a local dev setup. Nothing copies them
# into an image today; keeping them out of the context means a future COPY
# cannot pick them up by accident either.
.jwt_secret
.mfa_encryption_key
*.sarif

# Agent/tooling scratch space
.claude/
.superpowers/
plans/
