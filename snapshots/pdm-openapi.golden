  "AitoInvoiceResponse": {
   "description": "The Invoice card's contents, read live from Books on panel open.\n\nNot snapshotted onto the project like the quote fields are: an invoice's\ninteresting field is whether it has been PAID, and a stored copy of that\nis wrong the moment the client pays. The trade is that this card needs\nZoho reachable, where the Quote card renders from the database.\n\n``balance`` rides along with ``total`` because \"paid\" is the one thing\nthe operator opening this card wants to know, and Books' ``status`` alone\ndoes not distinguish a part-paid invoice from an unpaid one.",
   "properties": {
    "balance": {
     "title": "Balance",
     "type": "number"
    },
    "currency_code": {
     "title": "Currency Code",
     "type": "string"
    },
    "date": {
     "title": "Date",
     "type": "string"
    },
    "due_date": {
     "title": "Due Date",
     "type": "string"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "invoice_count": {
     "title": "Invoice Count",
     "type": "integer"
    },
    "number": {
     "title": "Number",
     "type": "string"
    },
    "status": {
     "title": "Status",
     "type": "string"
    },
    "total": {
     "title": "Total",
     "type": "number"
    },
    "url": {
     "title": "Url",
     "type": "string"
    }
   },
   "required": [
    "id",
    "number",
    "date",
    "due_date",
    "total",
    "balance",
    "currency_code",
    "status",
    "url",
    "invoice_count"
   ],
   "title": "AitoInvoiceResponse",
   "type": "object"
  },
