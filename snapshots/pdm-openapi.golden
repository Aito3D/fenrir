       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "X-Api-Key"
     }
    }
   ],
   "requestBody": {
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/AitoPickupSmsRequest"
      }
     }
    },
    "required": true
   },
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AitoPickupSmsResponse"
       }
      }
