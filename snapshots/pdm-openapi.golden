     "name": "X-API-Key",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "X-Api-Key"
     }
    }
   ],
   "requestBody": {
