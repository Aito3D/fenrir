      }
     ],
     "title": "Booking Error"
    },
    "booking_status": {
     "anyOf": [
      {
       "enum": [
        "pending",
        "booked",
        "failed",
        "not_booked"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Booking Status"
    },
    "created_at": {
     "format": "date-time",
     "title": "Created At",
     "type": "string"
    },
    "document_kind": {
     "enum": [
      "quote",
      "invoice"
     ],
     "title": "Document Kind",
     "type": "string"
    },
    "document_number": {
     "title": "Document Number",
     "type": "string"
    },
    "id": {
     "title": "Id",
     "type": "integer"
    },
    "settled_at": {
     "anyOf": [
      {
       "format": "date-time",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Settled At"
