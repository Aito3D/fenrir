  "GET /api/v1/projects/{project_id}/file-progress": {
   "description": "Completed-run counts per library file inside a project (#1897).\n\nCounts completed ``PrintLogEntry`` rows (same source as the aggregate\nproject stats) of archives attributed to this project, and maps each run to\none of the project's library files \u2014 the files living in folders linked to\nthe project, the same set the project detail page renders.\n\nA run is attributed to exactly one file, by the strongest available match:\n1. ``archive.library_file_id`` (stamped at queue dispatch since #1897),\n2. content hash (covers historical rows),\n3. filename (covers hash drift, e.g. re-sliced uploads of the same name).\nFiles with no completed runs are omitted \u2014 the frontend treats absence as 0.",
   "operationId": "get_project_file_progress_api_v1_projects__project_id__file_progress_get",
   "parameters": [
    {
     "in": "path",
     "name": "project_id",
     "required": true,
     "schema": {
      "title": "Project Id",
      "type": "integer"
     }
    },
    {
     "in": "header",
     "name": "X-API-Key",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "X-Api-Key"
     }
    }
   ],
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {
        "items": {
         "$ref": "#/components/schemas/ProjectFileProgress"
        },
        "title": "Response Get Project File Progress Api V1 Projects  Project Id  File Progress Get",
        "type": "array"
       }
      }
     },
     "description": "Successful Response"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/HTTPValidationError"
       }
      }
