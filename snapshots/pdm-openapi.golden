  "AitoInvoiceEmailContent": {
   "description": "The send-invoice modal's prefill.\n\n``recipients`` reuses ``AitoQuoteEmailRecipient``: an address Books offers\nhas the same three fields whichever document it was read from, and a\nparallel model with identical fields would be noise.\n\n``invoice_id`` and ``invoice_number`` name the document this prefill is\nabout. The modal echoes the id back on POST so the send is pinned to the\ninvoice the operator actually saw \u2014 the server still owns the candidate\nset and only checks the id for membership.",
   "properties": {
    "body": {
     "title": "Body",
     "type": "string"
    },
    "default_email": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Default Email"
    },
    "invoice_id": {
     "title": "Invoice Id",
     "type": "string"
    },
    "invoice_number": {
     "title": "Invoice Number",
     "type": "string"
    },
    "recipients": {
     "items": {
      "$ref": "#/components/schemas/AitoQuoteEmailRecipient"
     },
     "title": "Recipients",
     "type": "array"
    },
    "subject": {
     "title": "Subject",
     "type": "string"
    }
   },
   "required": [
    "subject",
    "body",
    "recipients",
    "default_email",
    "invoice_id",
    "invoice_number"
   ],
   "title": "AitoInvoiceEmailContent",
   "type": "object"
  },
  "AitoInvoiceEmailRequest": {
   "description": "``invoice_id`` may only NARROW the server's own candidate set \u2014 see\n``send_invoice_email``. Optional, and omitting it sends the newest, so a\ncaller that has not read the card yet is still served.",
   "properties": {
    "invoice_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Invoice Id"
    },
    "to": {
     "title": "To",
     "type": "string"
    }
   },
   "required": [
    "to"
   ],
   "title": "AitoInvoiceEmailRequest",
   "type": "object"
  },
  "AitoInvoiceLinkCreate": {
   "properties": {
