  "GET /api/v1/aito/{project_id}/invoice-preview": {
   "description": "What \"Create invoice\" would do, so the confirm dialog can say it.\n\nReads only. Runs the same guards as the create route so the dialog can\nnever open on a project the create would refuse \u2014 the alternative is an\noperator reading a full confirmation and then being told no.",
   "operationId": "get_invoice_preview_api_v1_aito__project_id__invoice_preview_get",
   "parameters": [
    {
