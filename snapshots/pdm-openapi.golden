  "AitoQuoteEmailContent": {
   "description": "The send modal's prefill.\n\n``body`` is Books' rendered HTML. Sanitised with DOMPurify and rendered by\n``ZohoEmailPreview`` inside an iframe with ``sandbox=\"\"`` and an\nin-document CSP \u2014 never inlined into the app document. (Not, as this\ndocstring used to claim, displayed as plain text: that was true before\nthe sandboxed preview component landed and has been stale since.)",
   "properties": {
    "body": {
     "title": "Body",
     "type": "string"
    },
    "default_email": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Default Email"
    },
    "recipients": {
     "items": {
      "$ref": "#/components/schemas/AitoQuoteEmailRecipient"
     },
     "title": "Recipients",
     "type": "array"
    },
    "subject": {
     "title": "Subject",
     "type": "string"
    }
   },
   "required": [
    "subject",
    "body",
    "recipients",
    "default_email"
   ],
   "title": "AitoQuoteEmailContent",
   "type": "object"
  },
  "AitoQuoteEmailRecipient": {
   "description": "One address this quote can be emailed to, as Books offers it.",
   "properties": {
    "contact_person_id": {
     "title": "Contact Person Id",
     "type": "string"
    },
    "email": {
     "title": "Email",
     "type": "string"
    },
    "name": {
     "title": "Name",
     "type": "string"
    }
   },
   "required": [
    "email",
    "name",
    "contact_person_id"
   ],
   "title": "AitoQuoteEmailRecipient",
   "type": "object"
  },
  "AitoQuoteEmailRequest": {
   "properties": {
    "to": {
     "title": "To",
     "type": "string"
    }
   },
   "required": [
    "to"
   ],
   "title": "AitoQuoteEmailRequest",
   "type": "object"
  },
  "AitoQuoteEmailResponse": {
   "description": "``marked_sent`` is a transport detail, exactly like\n``AitoQuoteStatusResponse.zoho_synced``: ``project`` goes straight into\nthe board cache and has no business carrying one request's outcome.\n\nTri-state, not a plain bool: ``True`` means the card moved to Waiting as\npart of this send; ``None`` means the move was never attempted because\nthe card was not in the Quote column (a legitimate re-send from Waiting\nor later \u2014 not a failure); ``False`` means the move was attempted and\nthe ``except SQLAlchemyError`` degrade in ``send_quote_email`` kicked in\n\u2014 the email went out (see that handler's docstring) but the card did\nnot move and needs a manual nudge. Collapsing the last two into one\n``False`` used to make a genuine failure indistinguishable from \"not\napplicable\", and the only client that read this field ignored it\neither way; see ``useSendQuoteMutation`` for how it now reacts to\n``False`` specifically.",
   "properties": {
    "marked_sent": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "null"
      }
     ],
     "title": "Marked Sent"
    },
    "project": {
     "$ref": "#/components/schemas/AitoProjectResponse"
    }
   },
   "required": [
    "project",
    "marked_sent"
   ],
   "title": "AitoQuoteEmailResponse",
   "type": "object"
  },
  "AitoQuoteStatusResponse": {
   "description": "``zoho_synced`` is a transport detail, so it rides alongside the project\nrather than on it: the frontend writes ``project`` straight into the board\ncache with setQueryData, and a cached board row has no business carrying\nthe outcome of one request.",
   "properties": {
    "no_op": {
     "default": false,
     "title": "No Op",
     "type": "boolean"
    },
    "project": {
     "$ref": "#/components/schemas/AitoProjectResponse"
    },
    "zoho_synced": {
     "title": "Zoho Synced",
     "type": "boolean"
    }
   },
   "required": [
    "project",
    "zoho_synced"
   ],
   "title": "AitoQuoteStatusResponse",
   "type": "object"
  },
  "AitoQuoteStatusUpdate": {
   "description": "The three transitions the board can drive. Zoho has no /status/draft, and\n`viewed` and `expired` are things that happen TO a quote rather than\ndecisions anyone makes \u2014 they only ever arrive from Zoho.",
   "properties": {
    "status": {
     "enum": [
      "sent",
      "accepted",
      "declined"
     ],
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "status"
   ],
   "title": "AitoQuoteStatusUpdate",
   "type": "object"
  },
