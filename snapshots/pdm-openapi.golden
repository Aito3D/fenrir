  "GET /api/v1/aito/{project_id}/events": {
   "description": "This project's timeline, newest first.\n\nOrdered by occurred_at then id, so the cursor must be the PAIR\n(occurred_at, id), not id alone. An id-only cursor is only equivalent to\nthe compound sort while id order and occurred_at order agree, and the\nbackfill breaks that: it inserts each project's synthesised\n'project.created' row with a freshly-assigned HIGH id but an OLD\noccurred_at (the project's own created_at, possibly years earlier than\nevery organic event). Filtering on `id < before` alone makes that row's\nid un-crossable \u2014 the cursor only ever shrinks past it \u2014 so it would never\nappear on any page, not merely be mis-ordered. Keying on both halves keeps\nthe cursor stable when several events share a timestamp (also routine\nafter a backfill) while still reaching rows whose id and occurred_at\ndisagree.",
   "operationId": "list_events_api_v1_aito__project_id__events_get",
   "parameters": [
    {
     "in": "path",
     "name": "project_id",
     "required": true,
     "schema": {
      "title": "Project Id",
      "type": "integer"
     }
    },
    {
     "in": "query",
     "name": "depth",
     "required": false,
     "schema": {
      "default": "detail",
      "enum": [
       "story",
       "detail",
       "everything"
      ],
      "title": "Depth",
      "type": "string"
     }
    },
    {
     "in": "query",
     "name": "before",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Before"
     }
    },
    {
     "in": "query",
     "name": "before_at",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Before At"
     }
    },
    {
     "in": "query",
     "name": "limit",
     "required": false,
     "schema": {
      "default": 50,
      "title": "Limit",
      "type": "integer"
     }
    },
    {
     "in": "header",
     "name": "X-API-Key",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "X-Api-Key"
     }
    }
   ],
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AitoEventPage"
       }
      }
     },
     "description": "Successful Response"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/HTTPValidationError"
       }
      }
     },
     "description": "Validation Error"
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ],
   "summary": "List Events",
   "tags": [
    "aito"
   ]
  },
  "GET /api/v1/aito/{project_id}/invoice": {
   "description": "The invoice Books raised from this project's quote, if there is one.\n\nRead live rather than from a stored snapshot \u2014 see ``AitoInvoiceResponse``\nfor why. That makes this the one Aito card that needs Zoho reachable.\n\nReturns ``null``, not a 404, when the project simply has no invoice: that\nis the ordinary state of every quoted job that has not been billed yet,\nand a 404 would have the client treat the commonest case as an error. A\n404 here means the PROJECT does not exist, which is a different fact.\n\nA project with no ``quote_id`` short-circuits without touching Zoho. That\nis not just an optimisation: see ``list_project_invoices`` for what Books\ndoes with an empty ``estimate_id``.",
   "operationId": "get_invoice_api_v1_aito__project_id__invoice_get",
   "parameters": [
    {
     "in": "path",
     "name": "project_id",
     "required": true,
     "schema": {
      "title": "Project Id",
      "type": "integer"
     }
    },
    {
     "in": "header",
     "name": "X-API-Key",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "X-Api-Key"
     }
    }
   ],
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {
        "anyOf": [
         {
          "$ref": "#/components/schemas/AitoInvoiceResponse"
         },
         {
          "type": "null"
         }
        ],
        "title": "Response Get Invoice Api V1 Aito  Project Id  Invoice Get"
       }
      }
     },
     "description": "Successful Response"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/HTTPValidationError"
       }
      }
     },
     "description": "Validation Error"
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ],
   "summary": "Get Invoice",
   "tags": [
    "aito"
   ]
  },
