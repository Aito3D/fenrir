  "AitoRetainerInvoiceResponse": {
   "description": "One retainer (deposit) invoice of this project, read live from Books\non panel open \u2014 for the same reason ``AitoInvoiceResponse`` is: its\ninteresting fields are ``status`` and ``balance``, and a snapshot of\neither is wrong the moment the client pays. ``url`` is the Books deep\nlink, built per request like the invoice's.",
   "properties": {
    "balance": {
     "title": "Balance",
     "type": "number"
    },
    "currency_code": {
     "title": "Currency Code",
     "type": "string"
    },
    "date": {
