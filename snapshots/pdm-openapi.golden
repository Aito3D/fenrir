     },
     "title": "Retainers",
     "type": "array"
    },
    "status": {
     "title": "Status",
     "type": "string"
    },
    "total": {
     "title": "Total",
     "type": "number"
    },
    "url": {
     "title": "Url",
     "type": "string"
    }
   },
