     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "X-Api-Key"
     }
    }
   ],
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {}
      }
     },
     "description": "Successful Response"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
