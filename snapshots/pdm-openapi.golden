      "failed",
      "cancelled",
      "expired",
      "needs_attention"
     ],
     "title": "Status",
     "type": "string"
    },
    "sync_error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Sync Error"
    }
   },
   "required": [
    "id",
    "document_kind",
    "document_number",
