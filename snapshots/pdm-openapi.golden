  "GET /api/v1/projects/{project_id}/cover-image": {
   "description": "Stream the project's cover image (#1155).\n\nBrowsers can't attach `Authorization: Bearer ...` to `<img src>` requests,\nso this route accepts a `?token=` media credential, the same one\n/archives/{id}/thumbnail takes. The frontend wraps URLs with `withMediaToken`.\n\nGated on ``projects:read`` like every other project route. It used to take\nthe camera-stream token, which required ``camera:view`` instead -- an\nunrelated permission that a user could hold without any project access, and\nthat a project reader could easily lack (#3025). Projects carry no\n``created_by_id``, so there is no per-row owner to check beyond that.",
   "operationId": "get_project_cover_image_api_v1_projects__project_id__cover_image_get",
   "parameters": [
    {
     "in": "path",
     "name": "project_id",
     "required": true,
     "schema": {
      "title": "Project Id",
      "type": "integer"
     }
    },
    {
     "in": "query",
     "name": "token",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Token"
     }
    },
    {
     "in": "header",
     "name": "X-API-Key",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "X-Api-Key"
     }
    }
   ],
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {}
      }
     },
     "description": "Successful Response"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/HTTPValidationError"
       }
      }
     },
     "description": "Validation Error"
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ],
   "summary": "Get Project Cover Image",
   "tags": [
    "projects"
   ]
  },
