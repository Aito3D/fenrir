  "POST /api/v1/queue/duplicate": {
   "description": "Queue another copy of each job in ``item_ids``, at the end of the queue (#3441).\n\nEach copy is cloned the way an order's remaining runs are\n(``add_queue_item_clone``): same file, plate, target, cross-model\ncandidates, project, mappings and print options, but a new run. On an\n\"any printer of a model\" job the printer the scheduler picked, and what\nwas worked out for it (tray mapping, \"Print Anyway\", nozzle choice), stay\nwith the original. Not copied either: the scheduled time, the batch (the\ncopy is an extra job, not one of the order's runs) and a ``manual_start``\nthe scheduler set (``held_by_scheduler``).\n\nGated like ``POST /queue/``: the caller must be able to see the job and to\nqueue its files, and the copy's target has to be in their printer scope.\nA job that fails any of that, is not queued or printing, or is a\nprinter-card upload whose file goes when the original dispatches (#2819),\ngets no copy and counts as skipped.",
   "operationId": "duplicate_queue_items_api_v1_queue_duplicate_post",
   "parameters": [
    {
     "in": "header",
     "name": "X-API-Key",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "X-Api-Key"
     }
    }
   ],
   "requestBody": {
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/PrintQueueDuplicateRequest"
      }
     }
    },
    "required": true
   },
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PrintQueueDuplicateResponse"
       }
      }
     },
     "description": "Successful Response"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/HTTPValidationError"
       }
      }
     },
     "description": "Validation Error"
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ],
   "summary": "Duplicate Queue Items",
   "tags": [
    "queue"
   ]
  },
  "POST /api/v1/queue/history/clear": {
   "description": "Remove the history the Queue page shows under its current filters.\n\nThe page used to send one DELETE per history row. Each row goes through\nthe same rule as that DELETE: an order's last run for a plate is kept as\ncancelled rather than deleted (#2960). Rows are handled one at a time, in\none transaction, so each check sees the rows removed before it.\n\nReaches only rows the caller could both see and delete, as the page's\none-by-one DELETEs did: someone who may delete every run but read only\ntheir own clears only their own.",
   "operationId": "clear_queue_history_api_v1_queue_history_clear_post",
   "parameters": [
    {
     "description": "Filter by printer (-1 for unassigned)",
     "in": "query",
