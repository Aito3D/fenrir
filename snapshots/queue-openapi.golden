  "POST /api/v1/queue/batches/{batch_id}/dispatch": {
   "description": "Queue the runs this order still owes (#342).\n\nEach new item is cloned from the most recent item for the same plate in\nthis batch, so it inherits the printer/model target, AMS mapping, filament\noverrides and print options the user already chose \u2014 and the validation\nthose went through at creation time.",
   "operationId": "dispatch_batch_api_v1_queue_batches__batch_id__dispatch_post",
   "parameters": [
    {
     "in": "path",
     "name": "batch_id",
