  "QueueVariantCreate": {
   "description": "One candidate file for a cross-model queue item (#671).\n\nPer-file rather than per-item because the settings genuinely differ between\ncandidates: an H2C slice is dual-nozzle and will not share slot count, AMS\nmapping or nozzle mapping with the H2S slice of the same model.\n\n``target_model`` is normally omitted and read from the file's own\n``sliced_for_model``; supply it only for a legacy 3MF that declares none.",
   "properties": {
    "ams_mapping": {
     "anyOf": [
      {
       "items": {
        "type": "integer"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "title": "Ams Mapping"
    },
    "filament_overrides": {
     "anyOf": [
      {
       "items": {
        "additionalProperties": true,
        "type": "object"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "title": "Filament Overrides"
    },
    "library_file_id": {
     "title": "Library File Id",
     "type": "integer"
    },
    "nozzle_mapping": {
     "anyOf": [
      {
       "items": {
        "type": "integer"
       },
       "type": "array"
      },
      {
