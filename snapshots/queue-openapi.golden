  "DELETE /api/v1/queue/{item_id}": {
   "description": "Remove an item from the queue.\n\nAn order's last surviving run for a plate is cancelled instead of deleted\n(#2960). The row is what a later dispatch clones, so removing it would\nleave the order reporting work outstanding that nothing could ever\nproduce. A completed run is exempt: it is the record of something that was\nactually made, and rewriting it as cancelled would falsify the order's\nprogress.",
   "operationId": "delete_queue_item_api_v1_queue__item_id__delete",
   "parameters": [
    {
     "in": "path",
     "name": "item_id",
     "required": true,
     "schema": {
      "title": "Item Id",
      "type": "integer"
     }
    },
    {
     "in": "header",
     "name": "X-API-Key",
     "required": false,
     "schema": {
