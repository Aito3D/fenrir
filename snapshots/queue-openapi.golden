       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "X-Api-Key"
     }
    }
   ],
   "requestBody": {
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/PrintBatchDispatchRequest"
      }
     }
    },
    "required": true
   },
   "responses": {
    "200": {
     "content": {
