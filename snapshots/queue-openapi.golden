  "POST /api/v1/queue/{item_id}/start": {
   "description": "Manually start a staged (manual_start) queue item.\n\nOwnership-scoped (#1625-followup): callers with QUEUE_UPDATE_OWN can\nstart their own items + claim ownership of NULL-owner items (VP-uploaded\nitems arrive unattributed per #1670). Callers with QUEUE_UPDATE_ALL can\nstart any item. Pre-fix this required QUEUE_UPDATE_OWN with no ownership\ncheck, so _OWN holders could start anyone's queue items via direct API.\n\nClears the manual_start flag so the scheduler picks it up. When\n``skip_filament_check`` is false (the default) the live filament\ndeficit (#1496) is checked first \u2014 if the assigned spool can't satisfy\na slot's required grams, the route returns ``409`` with the deficit\npayload so the caller can show a confirm dialog and retry with\n``skip_filament_check=true``. The same goes for a filament the printer has\nno tray for at all (#2799): ``409`` with ``code=unmatched_filament`` and\nthe missing filaments.",
   "operationId": "start_queue_item_api_v1_queue__item_id__start_post",
   "parameters": [
    {
     "in": "path",
     "name": "item_id",
     "required": true,
     "schema": {
      "title": "Item Id",
      "type": "integer"
     }
    },
    {
     "in": "query",
     "name": "skip_filament_check",
     "required": false,
     "schema": {
      "default": false,
      "title": "Skip Filament Check",
      "type": "boolean"
     }
    },
    {
     "in": "header",
     "name": "X-API-Key",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "X-Api-Key"
     }
    }
   ],
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {}
      }
     },
     "description": "Successful Response"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/HTTPValidationError"
       }
      }
     },
     "description": "Validation Error"
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ],
   "summary": "Start Queue Item",
   "tags": [
    "queue"
   ]
  },
  "POST /api/v1/queue/{item_id}/stop": {
   "description": "Stop an actively printing queue item.\n\nOwnership-scoped (#1625-followup): callers with QUEUE_UPDATE_OWN can stop\ntheir own items; callers with QUEUE_UPDATE_ALL can stop any item. Mirrors\nthe /cancel shape. Pre-fix this required QUEUE_UPDATE_ALL \u2014 Operators\nholding only _OWN saw the Stop button in the queue UI but got 403 on click.",
   "operationId": "stop_queue_item_api_v1_queue__item_id__stop_post",
   "parameters": [
    {
     "in": "path",
     "name": "item_id",
     "required": true,
