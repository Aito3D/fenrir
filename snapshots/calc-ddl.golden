CREATE TABLE calculator_defaults (
	id INTEGER NOT NULL, 
	electricity_tariff FLOAT NOT NULL, 
	labor_rate_per_hour FLOAT NOT NULL, 
	consumables_packaging_flat FLOAT NOT NULL, 
	failure_rate_pct FLOAT NOT NULL, 
	prototype_rate_pct FLOAT NOT NULL, 
	ads_rate_pct FLOAT NOT NULL, 
	filament_markup_pct FLOAT NOT NULL, 
	global_markup_pct FLOAT NOT NULL, 
	tax_pct FLOAT NOT NULL, 
	default_difficulty_pct FLOAT NOT NULL, 
	default_margin_over_cost_pct FLOAT NOT NULL, 
	stuff_markup_pct FLOAT NOT NULL, 
	base_fee_flat FLOAT NOT NULL, 
	margin_min_mult FLOAT NOT NULL, 
	margin_max_mult FLOAT NOT NULL, 
	margin_k FLOAT NOT NULL, 
	qty_min_factor FLOAT NOT NULL, 
	qty_k FLOAT NOT NULL, 
	min_task_price FLOAT NOT NULL, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	updated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id)
);
CREATE TABLE calculator_filaments (
	id INTEGER NOT NULL, 
	name VARCHAR(100) NOT NULL, 
	brand VARCHAR(100) NOT NULL, 
	material VARCHAR(100) NOT NULL, 
	cost_per_kg FLOAT NOT NULL, 
	sale_price_per_kg FLOAT NOT NULL, 
	margin_pct FLOAT NOT NULL, 
	difficulty_pct FLOAT NOT NULL, 
	zoho_item_id VARCHAR(50), 
	zoho_item_name VARCHAR(255), 
	zoho_sku VARCHAR(100), 
	spool_weight_kg FLOAT, 
	zoho_synced_at DATETIME, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	updated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id)
);
CREATE TABLE calculator_printers (
	id INTEGER NOT NULL, 
	name VARCHAR(100) NOT NULL, 
	purchase_price FLOAT NOT NULL, 
	lifetime_years FLOAT NOT NULL, 
	daily_usage_hours FLOAT NOT NULL, 
	power_watts FLOAT NOT NULL, 
	repair_rate_pct FLOAT NOT NULL, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	updated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id)
);

