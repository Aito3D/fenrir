CREATE TABLE aito_events (
	id INTEGER NOT NULL, 
	project_id INTEGER NOT NULL, 
	occurred_at DATETIME NOT NULL, 
	occurred_until DATETIME, 
	kind VARCHAR(40) NOT NULL, 
	actor_class VARCHAR(10) NOT NULL, 
	actor_name VARCHAR(100), 
	subject_type VARCHAR(20), 
	subject_id INTEGER, 
	subject_label VARCHAR(200), 
	changes JSON, 
	detail JSON, 
	note TEXT, 
	zoho_comment_id VARCHAR(50), 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id), 
	UNIQUE (zoho_comment_id)
);
CREATE TABLE aito_projects (
	id INTEGER NOT NULL, 
	description TEXT NOT NULL, 
	board_column VARCHAR(20) NOT NULL, 
	position INTEGER NOT NULL, 
	status VARCHAR(20) NOT NULL, 
	client_id VARCHAR(50), 
	client_name VARCHAR(200), 
	client_phone VARCHAR(50), 
	client_email VARCHAR(200), 
	client_is_company BOOLEAN, 
	client_social_network VARCHAR(20), 
	client_social_handle VARCHAR(100), 
	quote_id VARCHAR(50), 
	quote_number VARCHAR(50), 
	quote_date VARCHAR(10), 
	quote_total FLOAT, 
	quote_url VARCHAR(300), 
	quote_salesperson VARCHAR(200), 
	quote_status VARCHAR(30), 
	quote_accepted_at DATETIME, 
	created_by VARCHAR(100), 
	quote_sync_state VARCHAR(20) DEFAULT 'idle' NOT NULL, 
	quote_invoiced BOOLEAN DEFAULT '0' NOT NULL, 
	flag VARCHAR(16), 
	client_contacted_at DATETIME, 
	quote_sync_error TEXT, 
	quote_sync_failures INTEGER DEFAULT '0' NOT NULL, 
	quote_synced_at VARCHAR(30), 
	quote_status_before_trash VARCHAR(30), 
	quote_status_block VARCHAR(20), 
	quote_status_remote VARCHAR(30), 
	zoho_comments_watermark VARCHAR(30), 
	zoho_comments_checked_at DATETIME, 
	shipping_island VARCHAR(50), 
	shipping_service VARCHAR(20), 
	shipping_first_name VARCHAR(100), 
	shipping_last_name VARCHAR(100), 
	shipping_phone VARCHAR(50), 
	shipping_price FLOAT, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	updated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	version INTEGER DEFAULT '0' NOT NULL, 
	PRIMARY KEY (id)
);
CREATE TABLE aito_tasks (
	id INTEGER NOT NULL, 
	project_id INTEGER NOT NULL, 
	position INTEGER NOT NULL, 
	title VARCHAR(200), 
	scan_cost FLOAT, 
	modelisation_cost FLOAT, 
	usinage_cost FLOAT, 
	scan_quantity INTEGER, 
	modelisation_quantity INTEGER, 
	usinage_quantity INTEGER, 
	scan_discount_pct FLOAT, 
	modelisation_discount_pct FLOAT, 
	usinage_discount_pct FLOAT, 
	impression_printer_id INTEGER, 
	impression_filament_id INTEGER, 
	impression_weight_g FLOAT, 
	impression_time_min INTEGER, 
	impression_quantity INTEGER, 
	impression_color VARCHAR(100), 
	impression_cost FLOAT, 
	impression_discount_pct FLOAT, 
	scan_description TEXT, 
	modelisation_description TEXT, 
	impression_description TEXT, 
	usinage_description TEXT, 
	scan_done BOOLEAN DEFAULT '0' NOT NULL, 
	modelisation_done BOOLEAN DEFAULT '0' NOT NULL, 
	impression_done BOOLEAN DEFAULT '0' NOT NULL, 
	usinage_done BOOLEAN DEFAULT '0' NOT NULL, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	updated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id)
);
CREATE TABLE ams_labels (
	id INTEGER NOT NULL, 
	ams_serial_number VARCHAR(50) NOT NULL, 
	ams_id INTEGER, 
	label VARCHAR(100) NOT NULL, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	updated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id), 
	CONSTRAINT uq_ams_label_serial UNIQUE (ams_serial_number)
);
CREATE TABLE ams_sensor_history (
	id INTEGER NOT NULL, 
	printer_id INTEGER NOT NULL, 
	ams_id INTEGER NOT NULL, 
	humidity FLOAT, 
	humidity_raw FLOAT, 
	temperature FLOAT, 
	recorded_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id), 
	FOREIGN KEY(printer_id) REFERENCES printers (id) ON DELETE CASCADE
);
CREATE TABLE api_keys (
	id INTEGER NOT NULL, 
	name VARCHAR(100) NOT NULL, 
	key_hash VARCHAR(255) NOT NULL, 
	key_prefix VARCHAR(20) NOT NULL, 
	user_id INTEGER, 
	can_queue BOOLEAN NOT NULL, 
	can_control_printer BOOLEAN NOT NULL, 
	can_read_status BOOLEAN NOT NULL, 
	can_manage_library BOOLEAN NOT NULL, 
	can_manage_inventory BOOLEAN NOT NULL, 
	can_manage_maintenance BOOLEAN NOT NULL, 
	can_manage_archives BOOLEAN NOT NULL, 
	can_manage_projects BOOLEAN NOT NULL, 
	can_access_cloud BOOLEAN NOT NULL, 
	can_update_energy_cost BOOLEAN NOT NULL, 
	printer_ids JSON, 
	enabled BOOLEAN NOT NULL, 
	last_used DATETIME, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	expires_at DATETIME, 
	PRIMARY KEY (id), 
	FOREIGN KEY(user_id) REFERENCES users (id) ON DELETE CASCADE
);
CREATE TABLE auth_ephemeral_tokens (
	id INTEGER NOT NULL, 
	token VARCHAR(128) NOT NULL, 
	token_type VARCHAR(20) NOT NULL, 
	username VARCHAR(150), 
	provider_id INTEGER, 
	nonce VARCHAR(128), 
	code_verifier VARCHAR(128), 
	challenge_id VARCHAR(128), 
	expires_at DATETIME NOT NULL, 
	created_at DATETIME NOT NULL, 
	PRIMARY KEY (id)
);
CREATE TABLE auth_rate_limit_events (
	id INTEGER NOT NULL, 
	username VARCHAR(150) NOT NULL, 
	event_type VARCHAR(20) NOT NULL, 
	occurred_at DATETIME NOT NULL, 
	PRIMARY KEY (id)
);
CREATE TABLE budget_reservations (
	id INTEGER NOT NULL, 
	cost_center_id INTEGER NOT NULL, 
	amount NUMERIC(14, 2) NOT NULL, 
	status VARCHAR(20) NOT NULL, 
	source_type VARCHAR(50) NOT NULL, 
	source_id INTEGER, 
	print_archive_id INTEGER, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	released_at DATETIME, 
	PRIMARY KEY (id), 
	FOREIGN KEY(cost_center_id) REFERENCES cost_centers (id) ON DELETE CASCADE, 
	FOREIGN KEY(print_archive_id) REFERENCES print_archives (id) ON DELETE SET NULL
);
CREATE TABLE bug_reports (
	id INTEGER NOT NULL, 
	description TEXT NOT NULL, 
	reporter_email VARCHAR(255), 
	github_issue_number INTEGER, 
	github_issue_url VARCHAR(500), 
	status VARCHAR(20) NOT NULL, 
	error_message TEXT, 
