 "/api/v1/aito/{project_id}/quote-email": {
  "get": {
   "description": "What Books would send if this quote were emailed right now.\n\nPreview only. The send path deliberately re-reads all of this rather than\ntrusting whatever the client echoes back \u2014 see ``send_quote_email``.",
   "operationId": "get_quote_email_api_v1_aito__project_id__quote_email_get",
   "parameters": [
    {
     "in": "path",
     "name": "project_id",
     "required": true,
     "schema": {
      "title": "Project Id",
      "type": "integer"
