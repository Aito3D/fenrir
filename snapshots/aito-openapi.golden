 "/api/v1/aito/clients/{client_id}/history": {
  "get": {
   "description": "The drawer's repeat-client recall: a client's newest active cards with\ntheir tasks, and the latest social pair (Zoho never stores the handle).\nUnknown ids and the walk-in default contact return an empty list \u2014 the\ndrawer asks for every non-default contact, and most have no history. The\npanel's history timeline asks for 200 \u2014 every card the client ever had.\nDeclared ahead of the `/{project_id}` routes so `clients` is never parsed\nas an id.",
   "operationId": "get_client_history_api_v1_aito_clients__client_id__history_get",
   "parameters": [
    {
     "in": "path",
     "name": "client_id",
     "required": true,
     "schema": {
      "title": "Client Id",
      "type": "string"
     }
    },
    {
     "description": "Newest cards to return",
     "in": "query",
     "name": "limit",
     "required": false,
     "schema": {
      "default": 5,
      "description": "Newest cards to return",
      "maximum": 200,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
     }
    },
    {
     "in": "header",
     "name": "X-API-Key",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
