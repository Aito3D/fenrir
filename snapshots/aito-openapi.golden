 "/api/v1/aito/tasks/{task_id}": {
  "delete": {
   "description": "Hard delete, unlike projects: tasks need no stable visible number, and\nhold-to-remove is already a deliberate gesture.",
   "operationId": "delete_task_api_v1_aito_tasks__task_id__delete",
   "parameters": [
