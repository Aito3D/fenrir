    {
     "HTTPBearer": []
    }
   ],
   "summary": "Delete Task",
   "tags": [
    "aito"
   ]
  },
  "patch": {
   "description": "Only fields present in the body are written, so an omitted key is left\nalone and an explicit null disables that service.\n\nThree invariants hold across the write:\n\n- A done flag may not be set unless the project's quote is accepted.\n  Acceptance is what authorises the work; clearing a flag stays legal\n  regardless, so a tick stranded by a status flip can always be undone.\n- Clearing a cost to NULL clears its done flag. The step no longer exists,\n  and leaving the flag set would bring the service back pre-ticked if it\n  were ever re-enabled.\n- A done flag may not be set for a service with no cost. Checked against\n  the MERGED row rather than the stored one, so enabling a service and\n  ticking it in the same PATCH is legal while ticking a service that stays\n  absent is a 422.",
   "operationId": "update_task_api_v1_aito_tasks__task_id__patch",
   "parameters": [
    {
     "in": "path",
     "name": "task_id",
     "required": true,
     "schema": {
      "title": "Task Id",
      "type": "integer"
     }
    },
    {
     "in": "header",
     "name": "X-API-Key",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "X-Api-Key"
     }
    }
   ],
   "requestBody": {
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/AitoTaskUpdate"
      }
     }
    },
    "required": true
   },
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AitoTaskResponse"
       }
      }
     },
     "description": "Successful Response"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/HTTPValidationError"
       }
      }
     },
     "description": "Validation Error"
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ],
   "summary": "Update Task",
   "tags": [
    "aito"
   ]
  }
 },
 "/api/v1/aito/track/{token}": {
  "get": {
   "description": "The client's public tracking page. No auth: the token IS the\ncredential (a 6-character code, unique-indexed, normalised on lookup\nso case and look-alike letters never matter), and the auth middleware\nexempts this prefix. Declared ahead of the `/{project_id}` routes so\n`track` is never parsed as an id. Unknown, trashed, closed and expired\nlinks all get the same 404; past the rate limit everything is a 429.",
   "operationId": "get_tracking_api_v1_aito_track__token__get",
   "parameters": [
    {
     "in": "path",
