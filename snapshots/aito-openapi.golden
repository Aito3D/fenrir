 "/api/v1/aito/stats": {
  "get": {
   "description": "The Stats page's pipeline widget. Read-only aggregates over active\nprojects and their events; gated on AITO_READ alone, like the calculator\ninsights endpoint, so an Aito reader needs nothing else. Declared ahead of\nthe `/{project_id}` routes so `stats` is never parsed as an id.\n\nThe dates are LOCAL calendar days, converted with `tz_offset_minutes` the\nsame way `/archives/stats` does it \u2014 the Stats page's sibling widgets all\nrange over the user's own days, and a UTC-only window would slice the\nboard's period differently from the ones beside it.",
   "operationId": "get_aito_stats_api_v1_aito_stats_get",
   "parameters": [
    {
     "description": "Inclusive start day, in the caller's local time.",
     "in": "query",
     "name": "date_from",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "format": "date",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Inclusive start day, in the caller's local time.",
      "title": "Date From"
     }
    },
    {
     "description": "Inclusive end day, in the caller's local time.",
     "in": "query",
     "name": "date_to",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "format": "date",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Inclusive end day, in the caller's local time.",
      "title": "Date To"
     }
    },
    {
     "description": "Client UTC offset in minutes east of UTC",
     "in": "query",
     "name": "tz_offset_minutes",
     "required": false,
     "schema": {
      "default": 0,
      "description": "Client UTC offset in minutes east of UTC",
      "maximum": 840,
      "minimum": -840,
      "title": "Tz Offset Minutes",
      "type": "integer"
     }
    },
    {
     "in": "header",
     "name": "X-API-Key",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "X-Api-Key"
     }
    }
   ],
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AitoStatsResponse"
       }
      }
