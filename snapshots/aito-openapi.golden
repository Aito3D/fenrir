    "filament-profiles"
   ]
  }
 },
 "/api/v1/heimdall/test": {
  "post": {
   "description": "Ping Heimdall with the saved credential, or the overrides typed in\nthe card. Never a non-200: the card renders the outcome.",
   "operationId": "test_heimdall_api_v1_heimdall_test_post",
