     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AitoQuoteStatusResponse"
       }
      }
     },
     "description": "Successful Response"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/HTTPValidationError"
       }
      }
     },
     "description": "Validation Error"
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ],
   "summary": "Set Quote Status",
   "tags": [
    "aito"
   ]
  }
 },
 "/api/v1/aito/{project_id}/quote.pdf": {
  "get": {
   "description": "This project's Zoho estimate, rendered as a PDF for printing.\n\nA proxy rather than a redirect: the Books OAuth token is server-side only,\nand the browser has no way to authenticate against Zoho directly.\n\nReturned whole rather than streamed. A quote is a few pages, ``httpx`` has\nalready buffered the whole body inside ``get_estimate_pdf`` by the time we\nsee it, and a StreamingResponse over an in-memory ``bytes`` buys nothing\nbut a harder failure mode: a mid-stream Zoho error becomes a truncated\nPDF the browser renders as a blank print dialog, instead of the 502 below.",
