  pickup: boolean;
  payment: { currency: string; total: number; paid: number; left: number } | null;
  /** The checkout page of an open payment link, else null. */
  pay_url: string | null;
  updated_at: string;
}
export interface OrderLastEvent {
  kind: string;
  actor_name: string | null;
  occurred_at: string;
  detail: Record<string, unknown> | null;
}
export type OrderEvent = Omit<AitoEvent, 'occurred_until' | 'subject_type' | 'subject_id' | 'subject_label'>;
export interface OrderItemHit { id: string; name: string; sku: string; rate: number; stock_on_hand: number | null; product_type: string }
export type OrderEditLine = { line_id: string; quantity: number } | { item_id: string; quantity: number };
export interface OrderPackageContent { id: string; number: string; version: string; picklist_id: string; lines: { line_id: string; quantity: number; max: number }[]; pending: boolean }
export type OrderEditResult = { board: OrderBoardResponse; row: OrderBoardRow | null };
export type OrderPanelRow = Omit<OrderBoardRow, 'status'>;
export type FinishedOrderDetail = OrderPanelRow & { status: 'finished' };
export interface FinishedOrderRow { id: string; number: string; customer: string; date: string; total: number | null; currency: string; reference: string; units: { shipped: number; total: number }; paid_flag: OrderPayState | null; payment: OrderPayment | null; is_core: boolean | null; zoho_url: string | null;
  /** The day the last parcel left (YYYY-MM-DD); null when the stored copy does not say. */
  handed_over?: string | null }
export interface OrderBoardResponse {
  rows: OrderBoardRow[];
  /** Settings: a scan fills the parcel check. */
