export type OrderStatus = 'to_ship' | 'partial' | 'incoming' | 'to_order';
export type OrderLineState = 'ready' | 'backorder' | 'to_order' | 'shipped' | 'cancelled' | 'service';
export interface OrderBoardLine {
  id: string;
  item_id: string | null;
  name: string;
  sku: string;
  /** What a barcode on the product may read: the item's SKU, UPC, EAN, part number. */
  codes?: string[];
  state: OrderLineState;
  quantity: number;
  shipped: number;
  cancelled: number;
  remaining: number;
  /** Invoiced but not shipped: already out of stock on hand, so counted as ready. */
  invoiced: number;
  /** In a package with no delivery yet. */
  packed_waiting: number;
  /** What the shelf held for this line after older orders; null for a service line. */
  stock_available: number | null;
  covered: number;
  /** What can still go into a new parcel today. */
  packable: number;
  shortfall: number;
  covered_by_po: number;
  po_numbers: string[];
  /** Books' price per unit and the least this line may drop to (what already left or is billed). */
  rate: number;
  floor: number;
}
