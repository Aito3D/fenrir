 "/api/v1/filament-profiles/zoho-sync": {
  "post": {
   "description": "Price every profile from its matching Zoho item.\n\nMatches on brand + material + colour and writes ``filament_cost`` only where\nexactly one priced item matches. Everything else is left byte-identical and\nreported, so an auto-match can never silently write a wrong price.\n\nUnlike the calculator's sync this stores no link: the match is recomputed\nevery run, so there is nothing to keep in step. See the design doc for why\nauto-matching is safe here and not there.\n\nOne pass, no chunking: profiles are a hand-curated set. If that stops being\ntrue, the calculator's keyset paging is the pattern to copy.",
   "operationId": "sync_filament_presets_from_zoho_api_v1_filament_profiles_zoho_sync_post",
   "parameters": [
    {
     "in": "header",
     "name": "X-API-Key",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "X-Api-Key"
     }
    }
   ],
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/FilamentPresetZohoSyncResponse"
       }
      }
     },
     "description": "Successful Response"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/HTTPValidationError"
       }
      }
     },
     "description": "Validation Error"
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ],
   "summary": "Sync Filament Presets From Zoho",
   "tags": [
    "filament-profiles"
   ]
  }
 },
