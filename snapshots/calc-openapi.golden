 "/api/v1/calculator/filaments/zoho-sync": {
  "post": {
   "description": "Refresh one chunk of linked filaments from their Zoho dealer prices.\n\nChunking is keyset paging by id, client-driven: the caller loops, passing\neach response's ``next_after_id`` back as the next request's ``after_id``,\nuntil it comes back null. Unlike offset paging, a filament deleted (or\nadded) between chunks cannot shift the window and skip a row \u2014 the next\nchunk is always \"ids greater than the last one processed\". Each chunk\ncommits its own work, so a mid-run Zoho failure leaves earlier chunks\napplied and a retry resumes from the id it reports.\n\nPrices only. Brand, material, margin and difficulty are never rewritten from\nZoho, so a rename upstream cannot clobber a hand-corrected filament.",
   "operationId": "sync_calculator_filaments_from_zoho_api_v1_calculator_filaments_zoho_sync_post",
   "parameters": [
    {
     "in": "header",
     "name": "X-API-Key",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "X-Api-Key"
     }
    }
   ],
   "requestBody": {
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/CalculatorFilamentSyncRequest"
      }
     }
    },
    "required": true
   },
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CalculatorFilamentSyncResponse"
       }
      }
     },
     "description": "Successful Response"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/HTTPValidationError"
       }
      }
     },
     "description": "Validation Error"
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ],
   "summary": "Sync Calculator Filaments From Zoho",
   "tags": [
    "calculator"
   ]
  }
 },
