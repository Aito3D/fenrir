 "/api/v1/calculator/zoho-filaments": {
  "get": {
   "description": "Zoho products in the Filaments category, for linking to a calculator filament.\n\nResults are per Zoho item \u2014 colour included \u2014 because dealer prices differ\nbetween colours of the same material (Bambu ABS-GF is 1866 in Blue and 3208\nin Black), so which colour the user picks decides the price.",
   "operationId": "search_zoho_filaments_api_v1_calculator_zoho_filaments_get",
   "parameters": [
    {
     "description": "Free-text search over brand, material, colour and SKU",
     "in": "query",
     "name": "q",
     "required": false,
     "schema": {
      "default": "",
      "description": "Free-text search over brand, material, colour and SKU",
      "maxLength": 100,
      "title": "Q",
      "type": "string"
     }
    },
    {
     "in": "query",
     "name": "limit",
     "required": false,
     "schema": {
      "default": 25,
      "maximum": 100,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
     }
    },
    {
     "in": "header",
     "name": "X-API-Key",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "X-Api-Key"
     }
    }
   ],
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {
        "items": {
         "$ref": "#/components/schemas/ZohoFilamentProduct"
        },
        "title": "Response Search Zoho Filaments Api V1 Calculator Zoho Filaments Get",
        "type": "array"
       }
      }
     },
     "description": "Successful Response"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/HTTPValidationError"
       }
      }
     },
     "description": "Validation Error"
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ],
   "summary": "Search Zoho Filaments",
   "tags": [
    "calculator"
   ]
  }
 }
