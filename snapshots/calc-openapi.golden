 "/api/v1/calculator/insights": {
  "get": {
   "description": "Measured pricing signals (failure rates, tariff, spool costs, time accuracy).\n\nGated on CALCULATOR_READ alone by design: the aggregates are computed\nserver-side so a calculator-only user doesn't need archives/spool read\npermissions to benefit from them.",
   "operationId": "get_calculator_insights_api_v1_calculator_insights_get",
   "parameters": [
    {
     "in": "query",
     "name": "days",
     "required": false,
     "schema": {
      "default": 365,
      "maximum": 3650,
      "minimum": 7,
      "title": "Days",
      "type": "integer"
     }
