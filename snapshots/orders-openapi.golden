 "schemas": {
  "AitoClientRatingResponse": {
   "description": "A customer's payment rating for the drawer and the panel masthead \u2014\nsee docs/superpowers/specs/2026-09-22-aito-client-rating-design.md.\n\nStructured fields rather than a sentence, so the frontend phrases the\ntooltip in the viewer's language. ``unavailable`` is a response-only\ntier: Books could not be read and nothing was cached, so the pill stays\nhidden. ``stale`` means the figures come from the cache because Books\ncould not be read just now.",
   "properties": {
    "computed_at": {
     "anyOf": [
      {
       "format": "date-time",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Computed At"
    },
    "is_company": {
     "default": false,
     "title": "Is Company",
     "type": "boolean"
    },
    "on_time_count": {
     "default": 0,
     "title": "On Time Count",
     "type": "integer"
    },
    "overdue_count": {
     "default": 0,
     "title": "Overdue Count",
     "type": "integer"
    },
    "past_due_count": {
     "default": 0,
     "title": "Past Due Count",
     "type": "integer"
    },
    "reason": {
     "anyOf": [
      {
       "enum": [
        "overdue",
        "chronic",
        "new",
        "punctual",
        "mixed"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Reason"
    },
    "settled_count": {
     "default": 0,
     "title": "Settled Count",
     "type": "integer"
    },
    "stale": {
     "title": "Stale",
     "type": "boolean"
    },
    "tier": {
     "enum": [
      "good",
      "medium",
      "bad",
      "new",
      "unavailable"
     ],
     "title": "Tier",
     "type": "string"
    },
    "worst_overdue_days": {
     "default": 0,
     "title": "Worst Overdue Days",
     "type": "integer"
    },
    "worst_overdue_number": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Worst Overdue Number"
    }
   },
   "required": [
    "tier",
    "reason",
    "computed_at",
    "stale"
   ],
   "title": "AitoClientRatingResponse",
   "type": "object"
  },
