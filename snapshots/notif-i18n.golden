notifications.notifyLifecycleHelp = "Эфир активности автоматически отслеживает каждую печать. Переключатели ниже управляют только push-уведомлениями. Тихие часы блокируют новые активности; существующие продолжают обновляться и завершаться. Ежедневные сводки не задерживают активности."
notifications.notifyLiveActivities = "Эфир активности (iOS)"
