CREATE TABLE aito_events (
	id INTEGER NOT NULL, 
	project_id INTEGER NOT NULL, 
	occurred_at DATETIME NOT NULL, 
	occurred_until DATETIME, 
	kind VARCHAR(40) NOT NULL, 
	actor_class VARCHAR(10) NOT NULL, 
	actor_name VARCHAR(100), 
	subject_type VARCHAR(20), 
	subject_id INTEGER, 
	subject_label VARCHAR(200), 
	changes JSON, 
	detail JSON, 
	note TEXT, 
	zoho_comment_id VARCHAR(50), 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id), 
	UNIQUE (zoho_comment_id)
);
CREATE TABLE aito_projects (
	id INTEGER NOT NULL, 
	description TEXT NOT NULL, 
	board_column VARCHAR(20) NOT NULL, 
	position INTEGER NOT NULL, 
	status VARCHAR(20) NOT NULL, 
	client_id VARCHAR(50), 
	client_name VARCHAR(200), 
	client_phone VARCHAR(50), 
	client_email VARCHAR(200), 
	client_is_company BOOLEAN, 
	client_social_network VARCHAR(20), 
	client_social_handle VARCHAR(100), 
	quote_id VARCHAR(50), 
	quote_number VARCHAR(50), 
	quote_date VARCHAR(10), 
	quote_total FLOAT, 
	quote_url VARCHAR(300), 
	quote_salesperson VARCHAR(200), 
	quote_status VARCHAR(30), 
	quote_accepted_at DATETIME, 
	created_by VARCHAR(100), 
	quote_sync_state VARCHAR(20) DEFAULT 'idle' NOT NULL, 
	quote_invoiced BOOLEAN DEFAULT '0' NOT NULL, 
	flag VARCHAR(16), 
	quote_sync_error TEXT, 
	quote_sync_failures INTEGER DEFAULT '0' NOT NULL, 
	quote_synced_at VARCHAR(30), 
	quote_status_before_trash VARCHAR(30), 
	quote_status_block VARCHAR(20), 
	quote_status_remote VARCHAR(30), 
	zoho_comments_watermark VARCHAR(30), 
	zoho_comments_checked_at DATETIME, 
	shipping_island VARCHAR(50), 
	shipping_service VARCHAR(20), 
	shipping_first_name VARCHAR(100), 
	shipping_last_name VARCHAR(100), 
	shipping_phone VARCHAR(50), 
	shipping_price FLOAT, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	updated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	version INTEGER DEFAULT '0' NOT NULL, 
	PRIMARY KEY (id)
);
CREATE TABLE aito_tasks (
	id INTEGER NOT NULL, 
	project_id INTEGER NOT NULL, 
	position INTEGER NOT NULL, 
	title VARCHAR(200), 
	scan_cost FLOAT, 
	modelisation_cost FLOAT, 
	usinage_cost FLOAT, 
	impression_printer_id INTEGER, 
	impression_filament_id INTEGER, 
	impression_weight_g FLOAT, 
	impression_time_min INTEGER, 
	impression_quantity INTEGER, 
	impression_color VARCHAR(100), 
	impression_cost FLOAT, 
	impression_discount_pct FLOAT, 
	scan_description TEXT, 
	modelisation_description TEXT, 
	impression_description TEXT, 
	usinage_description TEXT, 
	scan_done BOOLEAN DEFAULT '0' NOT NULL, 
	modelisation_done BOOLEAN DEFAULT '0' NOT NULL, 
	impression_done BOOLEAN DEFAULT '0' NOT NULL, 
	usinage_done BOOLEAN DEFAULT '0' NOT NULL, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	updated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id)
);

