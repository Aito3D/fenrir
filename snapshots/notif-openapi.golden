 "schemas": {
  "AppMessage": {
   "description": "A message another application sends through Fenrir's notification channels.",
   "properties": {
    "message": {
     "maxLength": 2000,
     "minLength": 1,
     "title": "Message",
     "type": "string"
    },
    "title": {
     "maxLength": 120,
     "minLength": 1,
     "title": "Title",
     "type": "string"
    },
    "url": {
     "anyOf": [
      {
       "maxLength": 500,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "A link the message points to (http or https)",
     "title": "Url"
    }
   },
   "required": [
    "title",
    "message"
   ],
   "title": "AppMessage",
   "type": "object"
  },
  "AppMessageChannel": {
   "properties": {
    "name": {
     "title": "Name",
     "type": "string"
    },
    "provider_type": {
     "title": "Provider Type",
     "type": "string"
    }
   },
   "required": [
    "name",
    "provider_type"
   ],
   "title": "AppMessageChannel",
   "type": "object"
  },
  "AppMessageResult": {
   "properties": {
    "channels": {
     "description": "How many channels the message was handed to",
     "title": "Channels",
     "type": "integer"
    }
   },
   "required": [
    "channels"
   ],
   "title": "AppMessageResult",
   "type": "object"
  },
  "EventVariablesResponse": {
   "description": "Response for available variables per event type.",
   "properties": {
    "event_name": {
     "title": "Event Name",
     "type": "string"
    },
    "event_type": {
     "title": "Event Type",
     "type": "string"
    },
    "supports_photo": {
     "default": false,
     "title": "Supports Photo",
     "type": "boolean"
    },
    "variables": {
     "items": {
      "type": "string"
     },
     "title": "Variables",
     "type": "array"
    }
   },
   "required": [
    "event_type",
    "event_name",
    "variables"
   ],
   "title": "EventVariablesResponse",
   "type": "object"
  },
  "HTTPValidationError": {
   "properties": {
    "detail": {
     "items": {
      "$ref": "#/components/schemas/ValidationError"
     },
     "title": "Detail",
     "type": "array"
    }
   },
   "title": "HTTPValidationError",
   "type": "object"
  },
  "NotificationLogResponse": {
   "description": "Schema for notification log API responses.",
   "properties": {
    "created_at": {
     "format": "date-time",
     "title": "Created At",
     "type": "string"
    },
    "error_message": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Error Message"
    },
    "event_type": {
     "title": "Event Type",
     "type": "string"
    },
    "id": {
     "title": "Id",
     "type": "integer"
    },
    "message": {
     "title": "Message",
     "type": "string"
    },
    "printer_id": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "title": "Printer Id"
    },
    "printer_name": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Printer Name"
    },
    "provider_id": {
     "title": "Provider Id",
     "type": "integer"
    },
    "provider_name": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Provider Name"
    },
    "provider_type": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Provider Type"
    },
    "success": {
     "title": "Success",
     "type": "boolean"
    },
    "title": {
     "title": "Title",
     "type": "string"
    }
   },
   "required": [
    "id",
    "provider_id",
    "event_type",
    "title",
    "message",
    "success",
    "created_at"
   ],
   "title": "NotificationLogResponse",
   "type": "object"
  },
  "NotificationLogStats": {
   "description": "Statistics for notification logs.",
   "properties": {
    "by_event_type": {
     "additionalProperties": {
      "type": "integer"
     },
     "title": "By Event Type",
     "type": "object"
    },
    "by_provider": {
     "additionalProperties": {
      "type": "integer"
     },
     "title": "By Provider",
     "type": "object"
    },
    "failure_count": {
     "title": "Failure Count",
     "type": "integer"
    },
    "success_count": {
     "title": "Success Count",
     "type": "integer"
    },
    "total": {
     "title": "Total",
     "type": "integer"
    }
   },
   "required": [
    "total",
    "success_count",
    "failure_count",
    "by_event_type",
    "by_provider"
   ],
   "title": "NotificationLogStats",
   "type": "object"
  },
  "NotificationProviderCreate": {
   "description": "Schema for creating a notification provider.",
   "properties": {
    "attach_photo": {
     "default": true,
     "description": "Attach a camera snapshot to this provider's notifications when one is available",
     "title": "Attach Photo",
     "type": "boolean"
    },
    "config": {
     "additionalProperties": true,
     "description": "Provider-specific configuration",
     "title": "Config",
     "type": "object"
    },
    "daily_digest_enabled": {
     "default": false,
     "description": "Batch notifications into daily digest",
     "title": "Daily Digest Enabled",
     "type": "boolean"
    },
    "daily_digest_time": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "Time to send digest in HH:MM format",
     "title": "Daily Digest Time"
    },
    "enabled": {
     "default": true,
     "description": "Whether notifications are enabled",
     "title": "Enabled",
     "type": "boolean"
    },
    "name": {
     "description": "User-defined name",
     "maxLength": 100,
     "minLength": 1,
     "title": "Name",
     "type": "string"
    },
    "on_ai_failure_detection": {
     "default": false,
     "description": "Notify when AI failure detection identifies a possible print failure (spaghetti)",
     "title": "On Ai Failure Detection",
     "type": "boolean"
    },
    "on_aito_payment_received": {
     "default": false,
     "description": "Notify when an Aito quote is paid online or by a covering deposit",
     "title": "On Aito Payment Received",
     "type": "boolean"
    },
    "on_ams_drying_suspended": {
     "default": true,
     "description": "Notify when automatic drying gives up on an AMS unit",
     "title": "On Ams Drying Suspended",
     "type": "boolean"
    },
    "on_ams_ht_humidity_high": {
     "default": false,
     "description": "Notify when AMS-HT humidity exceeds threshold",
     "title": "On Ams Ht Humidity High",
     "type": "boolean"
    },
    "on_ams_ht_temperature_high": {
     "default": false,
     "description": "Notify when AMS-HT temperature exceeds threshold",
     "title": "On Ams Ht Temperature High",
     "type": "boolean"
    },
    "on_ams_humidity_high": {
     "default": false,
     "description": "Notify when AMS humidity exceeds threshold",
     "title": "On Ams Humidity High",
     "type": "boolean"
    },
    "on_ams_temperature_high": {
     "default": false,
     "description": "Notify when AMS temperature exceeds threshold",
     "title": "On Ams Temperature High",
     "type": "boolean"
    },
    "on_app_message": {
     "default": false,
     "description": "Deliver messages other applications send",
     "title": "On App Message",
     "type": "boolean"
    },
    "on_bed_cooled": {
     "default": false,
     "description": "Notify when bed cools after print",
     "title": "On Bed Cooled",
     "type": "boolean"
    },
    "on_billing_charge_failed": {
     "default": true,
     "description": "Notify when a print charge cannot be recorded",
     "title": "On Billing Charge Failed",
     "type": "boolean"
    },
    "on_filament_low": {
     "default": false,
     "description": "Notify when filament is running low",
     "title": "On Filament Low",
     "type": "boolean"
    },
    "on_first_layer_complete": {
     "default": false,
     "description": "Notify when first layer completes",
     "title": "On First Layer Complete",
     "type": "boolean"
    },
    "on_ha_sensor_alert": {
     "default": false,
     "description": "Notify when a bound Home Assistant sensor enters its alert state",
     "title": "On Ha Sensor Alert",
     "type": "boolean"
    },
    "on_location_ha_sensor_alert": {
     "default": false,
     "description": "Notify when a Home Assistant sensor bound to a storage location enters its alert state",
     "title": "On Location Ha Sensor Alert",
     "type": "boolean"
    },
    "on_maintenance_due": {
     "default": false,
     "description": "Notify when maintenance is due",
     "title": "On Maintenance Due",
     "type": "boolean"
    },
    "on_plate_clear_required": {
     "default": false,
     "description": "Notify when a finished print is waiting for plate-clear confirmation",
     "title": "On Plate Clear Required",
     "type": "boolean"
    },
    "on_plate_not_empty": {
     "default": true,
     "description": "Notify when objects detected on plate before print",
     "title": "On Plate Not Empty",
     "type": "boolean"
    },
    "on_print_complete": {
     "default": true,
     "description": "Notify on print complete",
     "title": "On Print Complete",
     "type": "boolean"
    },
    "on_print_confirm_request": {
     "default": true,
     "description": "Notify with one-tap verdict links when a print that opted in asks for its outcome",
     "title": "On Print Confirm Request",
     "type": "boolean"
    },
    "on_print_failed": {
     "default": true,
     "description": "Notify on print failed",
     "title": "On Print Failed",
     "type": "boolean"
    },
    "on_print_missing_spool_assignment": {
     "default": false,
     "description": "Notify when a print starts with required trays missing spool assignments",
     "title": "On Print Missing Spool Assignment",
     "type": "boolean"
    },
    "on_print_pause_upcoming": {
     "default": false,
     "description": "Notify before a pause in the print",
     "title": "On Print Pause Upcoming",
     "type": "boolean"
    },
    "on_print_progress": {
     "default": false,
     "description": "Notify at 25%, 50%, 75% progress",
     "title": "On Print Progress",
     "type": "boolean"
    },
    "on_print_start": {
     "default": false,
     "description": "Notify on print start",
     "title": "On Print Start",
     "type": "boolean"
    },
    "on_print_stopped": {
     "default": true,
     "description": "Notify when print is stopped/cancelled",
     "title": "On Print Stopped",
     "type": "boolean"
    },
    "on_printer_error": {
     "default": false,
     "description": "Notify on printer errors (AMS, etc.)",
     "title": "On Printer Error",
     "type": "boolean"
    },
    "on_printer_offline": {
     "default": false,
     "description": "Notify when printer goes offline",
     "title": "On Printer Offline",
     "type": "boolean"
    },
    "on_queue_completed": {
     "default": false,
     "description": "Notify when all queue jobs finish",
     "title": "On Queue Completed",
     "type": "boolean"
    },
    "on_queue_job_added": {
     "default": false,
     "description": "Notify when job is added to queue",
     "title": "On Queue Job Added",
     "type": "boolean"
    },
    "on_queue_job_assigned": {
     "default": false,
     "description": "Notify when model-based job is assigned to printer",
     "title": "On Queue Job Assigned",
     "type": "boolean"
    },
    "on_queue_job_failed": {
     "default": true,
     "description": "Notify when job fails to start",
     "title": "On Queue Job Failed",
     "type": "boolean"
    },
    "on_queue_job_skipped": {
     "default": true,
     "description": "Notify when job is skipped",
     "title": "On Queue Job Skipped",
     "type": "boolean"
    },
    "on_queue_job_started": {
     "default": false,
     "description": "Notify when queue job starts printing",
     "title": "On Queue Job Started",
     "type": "boolean"
    },
    "on_queue_job_waiting": {
     "default": true,
     "description": "Notify when job is waiting for filament or printer",
     "title": "On Queue Job Waiting",
     "type": "boolean"
    },
    "on_stock_break_alert": {
     "default": false,
     "description": "Notify when stock will run out before replenishment arrives",
     "title": "On Stock Break Alert",
     "type": "boolean"
    },
    "on_stock_reorder_alert": {
     "default": false,
     "description": "Notify when an inventory SKU hits its reorder point",
     "title": "On Stock Reorder Alert",
     "type": "boolean"
    },
    "printer_error_max_level": {
     "default": 2,
     "description": "Highest Bambu alert level to notify: 1 errors, 2 +warnings, 3 +notices",
     "maximum": 3.0,
     "minimum": 1.0,
     "title": "Printer Error Max Level",
     "type": "integer"
    },
    "printer_id": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "description": "Specific printer ID or null for all",
     "title": "Printer Id"
    },
    "provider_type": {
     "$ref": "#/components/schemas/backend__app__schemas__notification__ProviderType",
     "description": "Type of notification provider"
    },
    "quiet_hours_enabled": {
     "default": false,
     "description": "Enable quiet hours",
     "title": "Quiet Hours Enabled",
     "type": "boolean"
    },
    "quiet_hours_end": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "End time in HH:MM format",
     "title": "Quiet Hours End"
    },
    "quiet_hours_start": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "Start time in HH:MM format",
     "title": "Quiet Hours Start"
    },
    "telegram_verdict_mode": {
     "default": "buttons",
