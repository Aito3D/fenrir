CREATE TABLE hour_events (
	id INTEGER NOT NULL, 
	machine_id INTEGER NOT NULL, 
	event_date DATE NOT NULL, 
	kind VARCHAR(20) NOT NULL, 
	label VARCHAR(200) NOT NULL, 
	source_id INTEGER, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id), 
	FOREIGN KEY(machine_id) REFERENCES hour_machines (id) ON DELETE CASCADE
);
CREATE INDEX ix_hour_events_machine ON hour_events (machine_id);
CREATE TABLE hour_machines (
	id INTEGER NOT NULL, 
	printer_id INTEGER, 
	name VARCHAR(100) NOT NULL, 
	model VARCHAR(50), 
	serial_number VARCHAR(50), 
	retired BOOLEAN NOT NULL, 
	calibrated_at DATETIME, 
	last_drift_hours FLOAT, 
	purchase_price FLOAT, 
	purchase_date DATE, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id), 
	UNIQUE (printer_id), 
	FOREIGN KEY(printer_id) REFERENCES printers (id) ON DELETE SET NULL
);
CREATE TABLE hour_readings (
	id INTEGER NOT NULL, 
	machine_id INTEGER NOT NULL, 
	reading_date DATE NOT NULL, 
	hours FLOAT NOT NULL, 
	source VARCHAR(10) NOT NULL, 
	raw_hours FLOAT, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	updated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id), 
	CONSTRAINT uq_hour_reading UNIQUE (machine_id, reading_date, source), 
	FOREIGN KEY(machine_id) REFERENCES hour_machines (id) ON DELETE CASCADE
);
CREATE INDEX ix_hour_readings_machine_id ON hour_readings (machine_id);

