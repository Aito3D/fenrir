  "settings.preheatEnabledDesc": "When off, queued prints dispatch immediately. Each queue item can override per print.",
  "settings.preheatFilamentTargetsDefaultRow": "Other / unmapped",
  "settings.preheatFilamentTargetsHint": "Fenrir picks the highest target across the loaded AMS slots; PLA-only prints derive 0 and skip the chamber phase automatically.",
  "settings.preheatFilamentTargetsLabel": "Per-filament chamber target (°C)",
  "settings.preheatFilamentTargetsReset": "Reset to defaults",
  "settings.preheatHardwareDetail": "H2C/H2D/H2D Pro/H2S/X2D/X1E actively heat the chamber via M141. X1C/P2S read chamber temp but rely on bed-radiation heating. P1S/P1P/A1/A1 Mini have no chamber sensor — only the soak timer applies.",
  "settings.preheatHardwareTitle": "Per-printer behaviour:",
  "settings.preheatMaxWait": "Max wait (seconds)",
  "settings.preheatMaxWaitHelp": "Cap on the chamber warm-up phase before falling through.",
