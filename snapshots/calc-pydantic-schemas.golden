    "type": "number"
   },
   "name": {
    "description": "Printer name",
    "maxLength": 100,
    "minLength": 1,
    "title": "Name",
    "type": "string"
   },
   "power_watts": {
    "description": "Power draw in watts",
    "exclusiveMinimum": 0,
    "maximum": 100000000.0,
    "title": "Power Watts",
    "type": "number"
   },
   "purchase_price": {
    "description": "Purchase price (app currency)",
    "exclusiveMinimum": 0,
    "maximum": 100000000.0,
    "title": "Purchase Price",
    "type": "number"
   },
   "repair_rate_pct": {
    "description": "Expected repair cost over lifetime as % of purchase price",
    "maximum": 100,
    "minimum": 0,
    "title": "Repair Rate Pct",
    "type": "number"
   }
  },
  "required": [
   "name",
   "purchase_price",
   "lifetime_years",
   "daily_usage_hours",
   "power_watts",
   "repair_rate_pct"
  ],
  "title": "CalculatorPrinterCreate",
  "type": "object"
 },
 "CalculatorPrinterResponse": {
  "description": "Response schema for calculator printers.\n\nDerived per-hour values (lifetime hours, depreciation, repairs) are\ncomputed client-side by the pricing engine (frontend ``utils/pricing.ts``)\n\u2014 the single source of truth for calculator math.",
  "properties": {
   "created_at": {
    "format": "date-time",
    "title": "Created At",
    "type": "string"
   },
   "daily_usage_hours": {
    "description": "Average daily usage in hours",
    "exclusiveMinimum": 0,
    "maximum": 24,
    "title": "Daily Usage Hours",
    "type": "number"
   },
   "id": {
    "title": "Id",
    "type": "integer"
   },
   "lifetime_years": {
    "description": "Expected lifetime in years",
    "exclusiveMinimum": 0,
    "title": "Lifetime Years",
    "type": "number"
   },
   "name": {
    "description": "Printer name",
    "maxLength": 100,
    "minLength": 1,
    "title": "Name",
    "type": "string"
   },
   "power_watts": {
    "description": "Power draw in watts",
    "exclusiveMinimum": 0,
    "title": "Power Watts",
    "type": "number"
   },
   "purchase_price": {
    "description": "Purchase price (app currency)",
    "exclusiveMinimum": 0,
    "title": "Purchase Price",
    "type": "number"
   },
   "repair_rate_pct": {
    "description": "Expected repair cost over lifetime as % of purchase price",
    "maximum": 100,
    "minimum": 0,
    "title": "Repair Rate Pct",
    "type": "number"
   },
   "updated_at": {
    "format": "date-time",
    "title": "Updated At",
    "type": "string"
   }
  },
  "required": [
   "name",
   "purchase_price",
   "lifetime_years",
   "daily_usage_hours",
   "power_watts",
   "repair_rate_pct",
   "id",
   "created_at",
   "updated_at"
  ],
  "title": "CalculatorPrinterResponse",
  "type": "object"
 },
