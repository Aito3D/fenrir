  "title": "CalculatorFilamentUpdate",
  "type": "object"
 },
 "CalculatorInsightsResponse": {
  "$defs": {
   "DailyUsageEntry": {
    "description": "Measured usage-hours/day for one printer over the observed window.",
    "properties": {
     "hours_per_day": {
      "title": "Hours Per Day",
      "type": "number"
     },
     "observed_days": {
      "title": "Observed Days",
