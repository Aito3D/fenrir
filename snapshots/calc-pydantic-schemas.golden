 "CalculatorPrinterBase": {
  "description": "Base schema for calculator printers.\n\nDeliberately NOT given ``_FINITE_ONLY``/ceilings on its money fields: see\nthe equivalent note on ``CalculatorFilamentBase`` \u2014 this class also backs\n``CalculatorPrinterResponse``, and tightening it here would turn a\npre-existing out-of-range row into a 500 on every ``GET``.",
  "properties": {
   "daily_usage_hours": {
    "description": "Average daily usage in hours",
    "exclusiveMinimum": 0,
    "maximum": 24,
    "title": "Daily Usage Hours",
    "type": "number"
   },
   "lifetime_years": {
    "description": "Expected lifetime in years",
    "exclusiveMinimum": 0,
    "title": "Lifetime Years",
    "type": "number"
   },
   "name": {
    "description": "Printer name",
    "maxLength": 100,
    "minLength": 1,
    "title": "Name",
    "type": "string"
   },
   "power_watts": {
    "description": "Power draw in watts",
    "exclusiveMinimum": 0,
    "title": "Power Watts",
    "type": "number"
   },
   "purchase_price": {
    "description": "Purchase price (app currency)",
    "exclusiveMinimum": 0,
    "title": "Purchase Price",
    "type": "number"
   },
   "repair_rate_pct": {
    "description": "Expected repair cost over lifetime as % of purchase price",
    "maximum": 100,
    "minimum": 0,
    "title": "Repair Rate Pct",
    "type": "number"
   }
  },
  "required": [
   "name",
   "purchase_price",
   "lifetime_years",
   "daily_usage_hours",
   "power_watts",
   "repair_rate_pct"
  ],
  "title": "CalculatorPrinterBase",
  "type": "object"
 },
 "CalculatorPrinterCreate": {
  "description": "Schema for creating a calculator printer.",
  "properties": {
   "daily_usage_hours": {
    "description": "Average daily usage in hours",
    "exclusiveMinimum": 0,
    "maximum": 24,
