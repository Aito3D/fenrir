 "CalculatorFilamentSyncRequest": {
  "description": "One chunk of the Zoho price sync.\n\nKeyset paging by id, not offset: an offset would silently skip a row\nwhen a linked filament is deleted mid-run (the chunk boundary shifts\nunder the caller), and would still report success.",
  "properties": {
   "after_id": {
    "default": 0,
    "description": "Sync filaments with id greater than this; 0 starts from the beginning",
    "minimum": 0,
    "title": "After Id",
    "type": "integer"
   },
   "limit": {
    "default": 25,
    "description": "Chunk size",
    "maximum": 200,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   }
  },
  "title": "CalculatorFilamentSyncRequest",
  "type": "object"
 },
 "CalculatorFilamentSyncResponse": {
  "description": "Outcome of one sync chunk. The five outcome counts sum to ``processed``.",
  "properties": {
   "missing": {
    "description": "Linked item no longer in the Zoho catalogue; link and price kept",
    "title": "Missing",
    "type": "integer"
   },
   "next_after_id": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Pass as after_id for the next chunk; null when finished",
    "title": "Next After Id"
   },
   "processed": {
    "description": "Filaments examined in this chunk",
    "title": "Processed",
    "type": "integer"
   },
   "skipped_no_price": {
    "description": "Zoho dealer price was 0; nothing written",
    "title": "Skipped No Price",
    "type": "integer"
   },
   "total": {
    "description": "Linked filaments overall, for progress display",
    "title": "Total",
    "type": "integer"
   },
   "unchanged": {
    "description": "Zoho price matched the stored cost",
    "title": "Unchanged",
    "type": "integer"
   },
   "unpriced": {
    "description": "Filament has no stored spool weight and the Zoho item name carries none either (product.weight_inferred); dividing by the assumed 1 kg default was refused, so price kept",
    "title": "Unpriced",
    "type": "integer"
   },
   "updated": {
    "description": "Cost per kg changed",
    "title": "Updated",
    "type": "integer"
   }
  },
  "required": [
   "processed",
   "total",
   "updated",
   "unchanged",
   "skipped_no_price",
   "missing",
   "unpriced"
  ],
  "title": "CalculatorFilamentSyncResponse",
  "type": "object"
 },
 "CalculatorFilamentUpdate": {
  "description": "Schema for updating a calculator filament (all fields optional).\n\nThe Zoho fields and ``spool_weight_kg`` accept an explicit ``null`` \u2014 that\nis how the UI unlinks a filament from its Zoho product.\n\n``zoho_synced_at`` is deliberately NOT writable here: only a sync that\nactually applied a dealer price may stamp it. The patch route clears it by\nitself whenever ``zoho_item_id`` changes, so no caller has to remember to.",
  "properties": {
   "brand": {
    "anyOf": [
     {
      "maxLength": 100,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Brand"
   },
   "cost_per_kg": {
