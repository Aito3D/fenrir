 "CalculatorFilamentBase": {
  "description": "Base schema for calculator filaments.\n\n``sale_price_per_kg`` is deliberately absent: it is derived server-side from\n``cost_per_kg`` and ``margin_pct`` and only ever appears in responses.\n\nDeliberately NOT given ``_FINITE_ONLY``/a ceiling on ``cost_per_kg``, and\ndeliberately NOT given the ``ge=0, le=1000`` bounds on ``margin_pct``\neither: this class is also the parent of ``CalculatorFilamentResponse``,\nwhich reads back whatever is already in the database. Tightening either\nfield here would turn a pre-existing out-of-range row (e.g. a hand-typed\n``sale_price_per_kg`` below ``cost_per_kg``, backfilled to a negative\nmargin, or one more than ~11x cost, backfilled above 1000) into a 500 for\nthe ENTIRE list on every ``GET`` instead of the real, if unusual, value it\nrenders today; the write-side schemas below carry the new constraints\ninstead, so only new writes are rejected.",
  "properties": {
   "brand": {
    "default": "",
    "description": "Filament brand (optional)",
    "maxLength": 100,
    "title": "Brand",
    "type": "string"
   },
   "cost_per_kg": {
    "description": "Purchase cost per kg (app currency)",
    "exclusiveMinimum": 0,
    "title": "Cost Per Kg",
    "type": "number"
   },
   "difficulty_pct": {
    "default": 100.0,
    "description": "Difficulty multiplier for this filament (100 = no surcharge)",
    "maximum": 1000,
    "minimum": 100,
    "title": "Difficulty Pct",
    "type": "number"
   },
   "margin_pct": {
    "default": 50.0,
    "description": "Margin over cost, percent",
    "title": "Margin Pct",
    "type": "number"
   },
   "material": {
    "description": "Filament material, e.g. PLA or PETG-CF",
    "maxLength": 100,
    "minLength": 1,
    "title": "Material",
    "type": "string"
   },
   "spool_weight_kg": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 100,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Spool weight used to derive cost per kg from the dealer price",
    "title": "Spool Weight Kg"
   },
   "zoho_item_id": {
    "anyOf": [
     {
      "maxLength": 50,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Linked Zoho item id",
    "title": "Zoho Item Id"
   },
   "zoho_item_name": {
    "anyOf": [
     {
      "maxLength": 255,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Linked Zoho item name",
    "title": "Zoho Item Name"
   },
   "zoho_sku": {
    "anyOf": [
     {
      "maxLength": 100,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Linked Zoho item SKU",
    "title": "Zoho Sku"
   }
  },
  "required": [
   "material",
   "cost_per_kg"
  ],
  "title": "CalculatorFilamentBase",
  "type": "object"
 },
