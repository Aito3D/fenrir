    "body_template": "{material} {subtype} {color} ({brand}) will run out before replenishment arrives.\nStock: {stock_g}g | Rate: {rate_g_day}g/day | Lead time: {lead_time_days}d\nOnly {days_left}d of stock remaining \u2014 order immediately.",
    "created_at": "<ts>",
    "event_type": "stock_break_alert",
