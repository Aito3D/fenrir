 "AitoClientRatingResponse": {
  "description": "A customer's payment rating for the drawer and the panel masthead \u2014\nsee docs/superpowers/specs/2026-09-22-aito-client-rating-design.md.\n\nStructured fields rather than a sentence, so the frontend phrases the\ntooltip in the viewer's language. ``unavailable`` is a response-only\ntier: Books could not be read and nothing was cached, so the pill stays\nhidden. ``stale`` means the figures come from the cache because Books\ncould not be read just now.",
  "properties": {
   "computed_at": {
    "anyOf": [
     {
      "format": "date-time",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "title": "Computed At"
   },
   "is_company": {
    "default": false,
    "title": "Is Company",
    "type": "boolean"
   },
   "on_time_count": {
    "default": 0,
    "title": "On Time Count",
    "type": "integer"
   },
   "overdue_count": {
    "default": 0,
    "title": "Overdue Count",
    "type": "integer"
   },
   "past_due_count": {
    "default": 0,
    "title": "Past Due Count",
    "type": "integer"
   },
   "reason": {
    "anyOf": [
     {
      "enum": [
       "overdue",
       "chronic",
       "new",
       "punctual",
       "mixed"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "title": "Reason"
   },
   "settled_count": {
    "default": 0,
    "title": "Settled Count",
    "type": "integer"
   },
   "stale": {
    "title": "Stale",
    "type": "boolean"
   },
   "tier": {
    "enum": [
     "good",
     "medium",
     "bad",
     "new",
     "unavailable"
    ],
    "title": "Tier",
    "type": "string"
   },
   "worst_overdue_days": {
    "default": 0,
    "title": "Worst Overdue Days",
    "type": "integer"
   },
   "worst_overdue_number": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Worst Overdue Number"
   }
  },
  "required": [
   "tier",
   "reason",
   "computed_at",
   "stale"
  ],
  "title": "AitoClientRatingResponse",
  "type": "object"
 },
 "AitoClientSocialInput": {
  "description": "The optional social channel, shared by create and update.\n\nHandle validation is deliberately just \"non-empty after trimming\": a\nWhatsApp handle is a phone number and an Instagram one is not, and four\npatterns for platforms we do not control would drift. Nothing downstream\nturns the value into a link, so a value we cannot parse costs nothing.",
  "properties": {
   "client_social_handle": {
    "anyOf": [
     {
      "maxLength": 100,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Client Social Handle"
   },
   "client_social_network": {
    "anyOf": [
     {
      "maxLength": 20,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Client Social Network"
   }
  },
  "title": "AitoClientSocialInput",
  "type": "object"
 },
 "AitoClientTransfer": {
  "description": "PUT /aito/{id}/transfer-client \u2014 the card changes hands. Same caps and\nphone/email checks as AitoProjectCreate's client fields; the social pair\nis NOT accepted (it belonged to the old client and is cleared).",
  "properties": {
   "client_contact_person_id": {
    "anyOf": [
     {
      "maxLength": 50,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Client Contact Person Id"
   },
   "client_email": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Client Email"
   },
   "client_id": {
    "maxLength": 50,
    "minLength": 1,
    "title": "Client Id",
    "type": "string"
   },
   "client_is_company": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Client Is Company"
   },
   "client_name": {
    "maxLength": 200,
    "minLength": 1,
    "title": "Client Name",
    "type": "string"
   },
   "client_phone": {
    "anyOf": [
     {
      "maxLength": 50,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Client Phone"
   }
  },
  "required": [
   "client_id",
   "client_name"
  ],
  "title": "AitoClientTransfer",
  "type": "object"
 },
 "AitoContactedUpdate": {
  "description": "Body of PATCH /aito/{id}/contacted.\n\nA bool rather than the timestamp itself, deliberately: WHEN the client was\ntold is the server's fact to record, and letting a client post its own\ntime would put the card's age \u2014 and the Done gate \u2014 at the mercy of a\nwrong clock in a browser.",
  "properties": {
   "contacted": {
    "title": "Contacted",
    "type": "boolean"
   }
  },
  "required": [
   "contacted"
  ],
  "title": "AitoContactedUpdate",
  "type": "object"
 },
 "AitoDueDateUpdate": {
  "description": "Body of PATCH /aito/{id}/due-date. One required field, same shape as\nAitoFlagUpdate: `None` clears the promise, it is not \"leave alone\".",
  "properties": {
   "due_date": {
    "anyOf": [
     {
      "format": "date",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "title": "Due Date"
   }
  },
  "required": [
   "due_date"
  ],
  "title": "AitoDueDateUpdate",
  "type": "object"
 },
