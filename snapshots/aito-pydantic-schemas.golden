   "body",
   "recipients",
   "default_email",
   "retainer_id",
   "retainer_number"
  ],
  "title": "AitoRetainerEmailContent",
  "type": "object"
 },
 "AitoRetainerEmailRequest": {
  "description": "``retainer_id`` is required, unlike the invoice's optional pin: there\nis no \"newest\" default worth having \u2014 the card always knows which row\nwas clicked.",
  "properties": {
   "retainer_id": {
    "title": "Retainer Id",
    "type": "string"
   },
   "to": {
    "title": "To",
    "type": "string"
   }
  },
  "required": [
