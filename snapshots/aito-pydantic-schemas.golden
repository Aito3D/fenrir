  "type": "object"
 },
 "AitoQuoteEmailContent": {
  "$defs": {
   "AitoQuoteEmailRecipient": {
    "description": "One address this quote can be emailed to, as Books offers it.",
    "properties": {
     "contact_person_id": {
      "title": "Contact Person Id",
      "type": "string"
     },
     "email": {
      "title": "Email",
      "type": "string"
     },
     "name": {
      "title": "Name",
      "type": "string"
     }
    },
    "required": [
     "email",
     "name",
     "contact_person_id"
    ],
    "title": "AitoQuoteEmailRecipient",
    "type": "object"
   }
  },
  "description": "The send modal's prefill.\n\n``body`` is Books' rendered HTML. Sanitised with DOMPurify and rendered by\n``ZohoEmailPreview`` inside an iframe with ``sandbox=\"\"`` and an\nin-document CSP \u2014 never inlined into the app document. (Not, as this\ndocstring used to claim, displayed as plain text: that was true before\nthe sandboxed preview component landed and has been stale since.)",
  "properties": {
   "body": {
    "title": "Body",
    "type": "string"
   },
   "default_email": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "title": "Default Email"
   },
   "recipients": {
    "items": {
     "$ref": "#/$defs/AitoQuoteEmailRecipient"
    },
    "title": "Recipients",
    "type": "array"
   },
   "subject": {
    "title": "Subject",
    "type": "string"
   }
  },
  "required": [
   "subject",
   "body",
   "recipients",
   "default_email"
  ],
  "title": "AitoQuoteEmailContent",
  "type": "object"
 },
