  "type": "object"
 },
 "AitoRetainerInvoiceResponse": {
  "description": "One retainer (deposit) invoice of this project, read live from Books\non panel open \u2014 for the same reason ``AitoInvoiceResponse`` is: its\ninteresting fields are ``status`` and ``balance``, and a snapshot of\neither is wrong the moment the client pays. ``url`` is the Books deep\nlink, built per request like the invoice's.",
  "properties": {
   "balance": {
    "title": "Balance",
    "type": "number"
   },
   "currency_code": {
    "title": "Currency Code",
    "type": "string"
   },
   "date": {
    "title": "Date",
    "type": "string"
   },
   "id": {
    "title": "Id",
    "type": "string"
   },
   "number": {
    "title": "Number",
    "type": "string"
   },
   "status": {
    "title": "Status",
    "type": "string"
   },
   "total": {
    "title": "Total",
    "type": "number"
   },
   "url": {
    "title": "Url",
    "type": "string"
   }
  },
  "required": [
   "id",
   "number",
   "date",
   "total",
   "balance",
   "currency_code",
   "status",
   "url"
  ],
  "title": "AitoRetainerInvoiceResponse",
  "type": "object"
 },
 "AitoRetainerPreview": {
  "description": "One deposit already taken against this quote, and what of it is spendable.\n\n``applicable`` is what can be put on the new invoice: the sum of the\nretainer's UNUSED advance payments, which is 0 for a retainer that is\nunpaid and also 0 for one already drawn against an earlier invoice.\n``total - applicable`` is the part the dialog reports as not applied \u2014\nthe operator needs to see the deposit exists either way, because a\nretainer silently missing from the confirm dialog reads as \"there was no\ndeposit\", which is the one thing that would make them bill it twice.",
  "properties": {
   "applicable": {
    "title": "Applicable",
    "type": "number"
   },
   "id": {
    "title": "Id",
    "type": "string"
   },
   "number": {
    "title": "Number",
    "type": "string"
   },
   "status": {
    "title": "Status",
    "type": "string"
   },
   "total": {
    "title": "Total",
    "type": "number"
   }
  },
  "required": [
   "id",
   "number",
   "status",
   "total",
   "applicable"
  ],
  "title": "AitoRetainerPreview",
  "type": "object"
 },
