 "AitoFlagUpdate": {
  "description": "Body of PATCH /aito/{id}/flag. A single required field: this route\nexists to write exactly one flag, so `exclude_unset` semantics (which\n`AitoProjectUpdate` needs) would only make \"absent\" ambiguous here.\n\n`None` is the third state \u2014 no flag \u2014 not \"leave it alone\".",
  "properties": {
   "flag": {
    "anyOf": [
     {
      "enum": [
       "urgent",
       "sav",
       "pause",
       "fiverr"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "title": "Flag"
   }
  },
  "required": [
   "flag"
  ],
  "title": "AitoFlagUpdate",
  "type": "object"
 },
 "AitoInvoiceCreatedResponse": {
  "$defs": {
   "AitoRetainerApplied": {
    "description": "What actually happened to one retainer, reported after the fact.",
    "properties": {
     "applied": {
      "title": "Applied",
      "type": "number"
     },
     "number": {
      "title": "Number",
      "type": "string"
     },
     "total": {
      "title": "Total",
      "type": "number"
     }
    },
    "required": [
     "number",
     "total",
     "applied"
    ],
    "title": "AitoRetainerApplied",
    "type": "object"
   }
  },
  "description": "The new invoice, in the exact shape the Invoice card already renders.\n\nExtends ``AitoInvoiceResponse`` rather than sitting beside it so the\nfrontend can seed the ``['aito-invoice', id]`` cache straight from this\nresponse, the way the send route's does \u2014 the card then appears with no\nsecond round trip. ``retainers`` is the extra, and it is what the success\ntoast reports.",
  "properties": {
   "balance": {
    "title": "Balance",
    "type": "number"
   },
   "currency_code": {
    "title": "Currency Code",
    "type": "string"
   },
   "date": {
    "title": "Date",
    "type": "string"
   },
   "due_date": {
    "title": "Due Date",
    "type": "string"
   },
   "id": {
    "title": "Id",
    "type": "string"
   },
   "invoice_count": {
    "title": "Invoice Count",
    "type": "integer"
   },
   "number": {
    "title": "Number",
    "type": "string"
   },
   "retainers": {
    "items": {
     "$ref": "#/$defs/AitoRetainerApplied"
    },
    "title": "Retainers",
    "type": "array"
   },
   "status": {
    "title": "Status",
    "type": "string"
   },
   "total": {
    "title": "Total",
    "type": "number"
   },
   "url": {
    "title": "Url",
    "type": "string"
   }
  },
  "required": [
   "id",
   "number",
   "date",
   "due_date",
   "total",
   "balance",
   "currency_code",
   "status",
   "url",
   "invoice_count",
   "retainers"
  ],
  "title": "AitoInvoiceCreatedResponse",
  "type": "object"
 },
 "AitoInvoiceEmailContent": {
  "$defs": {
   "AitoQuoteEmailRecipient": {
    "description": "One address this quote can be emailed to, as Books offers it.",
    "properties": {
     "contact_person_id": {
      "title": "Contact Person Id",
      "type": "string"
     },
     "email": {
      "title": "Email",
      "type": "string"
     },
     "name": {
      "title": "Name",
      "type": "string"
     }
    },
    "required": [
     "email",
     "name",
     "contact_person_id"
    ],
    "title": "AitoQuoteEmailRecipient",
    "type": "object"
   }
  },
  "description": "The send-invoice modal's prefill.\n\n``recipients`` reuses ``AitoQuoteEmailRecipient``: an address Books offers\nhas the same three fields whichever document it was read from, and a\nparallel model with identical fields would be noise.\n\n``invoice_id`` and ``invoice_number`` name the document this prefill is\nabout. The modal echoes the id back on POST so the send is pinned to the\ninvoice the operator actually saw \u2014 the server still owns the candidate\nset and only checks the id for membership.",
  "properties": {
   "body": {
    "title": "Body",
    "type": "string"
   },
   "default_email": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "title": "Default Email"
   },
   "invoice_id": {
    "title": "Invoice Id",
    "type": "string"
   },
   "invoice_number": {
    "title": "Invoice Number",
    "type": "string"
   },
   "recipients": {
    "items": {
     "$ref": "#/$defs/AitoQuoteEmailRecipient"
    },
    "title": "Recipients",
    "type": "array"
   },
   "subject": {
    "title": "Subject",
    "type": "string"
   }
  },
  "required": [
   "subject",
   "body",
   "recipients",
   "default_email",
   "invoice_id",
   "invoice_number"
  ],
  "title": "AitoInvoiceEmailContent",
  "type": "object"
 },
 "AitoInvoiceEmailRequest": {
  "description": "``invoice_id`` may only NARROW the server's own candidate set \u2014 see\n``send_invoice_email``. Optional, and omitting it sends the newest, so a\ncaller that has not read the card yet is still served.",
  "properties": {
   "invoice_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Invoice Id"
   },
   "to": {
    "title": "To",
    "type": "string"
   }
  },
  "required": [
   "to"
  ],
  "title": "AitoInvoiceEmailRequest",
  "type": "object"
 },
 "AitoInvoiceLinkCreate": {
  "properties": {
   "amount": {
    "exclusiveMinimum": 0,
    "maximum": 999999999999,
    "title": "Amount",
    "type": "integer"
   },
   "document_id": {
    "maxLength": 100,
    "minLength": 1,
    "title": "Document Id",
    "type": "string"
   }
  },
  "required": [
   "document_id",
   "amount"
  ],
  "title": "AitoInvoiceLinkCreate",
  "type": "object"
 },
 "AitoInvoicePreview": {
  "$defs": {
   "AitoRetainerPreview": {
    "description": "One deposit already taken against this quote, and what of it is spendable.\n\n``applicable`` is what can be put on the new invoice: the sum of the\nretainer's UNUSED advance payments, which is 0 for a retainer that is\nunpaid and also 0 for one already drawn against an earlier invoice.\n``total - applicable`` is the part the dialog reports as not applied \u2014\nthe operator needs to see the deposit exists either way, because a\nretainer silently missing from the confirm dialog reads as \"there was no\ndeposit\", which is the one thing that would make them bill it twice.",
    "properties": {
     "applicable": {
      "title": "Applicable",
      "type": "number"
     },
     "id": {
      "title": "Id",
      "type": "string"
     },
     "number": {
      "title": "Number",
      "type": "string"
     },
     "status": {
      "title": "Status",
      "type": "string"
     },
     "total": {
      "title": "Total",
      "type": "number"
     }
    },
    "required": [
     "id",
     "number",
     "status",
     "total",
     "applicable"
    ],
    "title": "AitoRetainerPreview",
    "type": "object"
   }
  },
  "description": "What \"Create invoice\" is about to do, read from Books before it does it.\n\nFeeds the confirm dialog only. The create route re-reads all of it rather\nthan trusting what comes back \u2014 see ``create_invoice`` \u2014 so nothing here\nis load-bearing beyond the sentence the operator reads.",
  "properties": {
   "currency_code": {
    "title": "Currency Code",
    "type": "string"
   },
   "line_count": {
    "title": "Line Count",
    "type": "integer"
   },
   "projected_balance": {
    "title": "Projected Balance",
    "type": "number"
   },
   "quote_number": {
    "title": "Quote Number",
    "type": "string"
   },
   "retainers": {
    "items": {
     "$ref": "#/$defs/AitoRetainerPreview"
    },
    "title": "Retainers",
    "type": "array"
   },
   "total": {
    "title": "Total",
    "type": "number"
   }
  },
  "required": [
   "quote_number",
   "currency_code",
   "total",
   "line_count",
   "retainers",
   "projected_balance"
  ],
  "title": "AitoInvoicePreview",
  "type": "object"
 },
 "AitoInvoiceResponse": {
  "description": "The Invoice card's contents, read live from Books on panel open.\n\nNot snapshotted onto the project like the quote fields are: an invoice's\ninteresting field is whether it has been PAID, and a stored copy of that\nis wrong the moment the client pays. The trade is that this card needs\nZoho reachable, where the Quote card renders from the database.\n\n``balance`` rides along with ``total`` because \"paid\" is the one thing\nthe operator opening this card wants to know, and Books' ``status`` alone\ndoes not distinguish a part-paid invoice from an unpaid one.",
  "properties": {
   "balance": {
    "title": "Balance",
    "type": "number"
   },
   "currency_code": {
    "title": "Currency Code",
    "type": "string"
   },
   "date": {
    "title": "Date",
    "type": "string"
   },
   "due_date": {
    "title": "Due Date",
    "type": "string"
   },
   "id": {
    "title": "Id",
    "type": "string"
   },
   "invoice_count": {
    "title": "Invoice Count",
    "type": "integer"
   },
   "number": {
    "title": "Number",
    "type": "string"
   },
   "status": {
    "title": "Status",
    "type": "string"
   },
   "total": {
    "title": "Total",
    "type": "number"
   },
   "url": {
    "title": "Url",
    "type": "string"
   }
  },
  "required": [
   "id",
   "number",
   "date",
   "due_date",
   "total",
   "balance",
   "currency_code",
   "status",
   "url",
   "invoice_count"
  ],
  "title": "AitoInvoiceResponse",
  "type": "object"
 },
 "AitoManualPaymentCreate": {
  "properties": {
   "amount": {
    "exclusiveMinimum": 0,
    "maximum": 999999999999,
    "title": "Amount",
    "type": "integer"
   },
   "document_id": {
    "maxLength": 100,
    "minLength": 1,
    "title": "Document Id",
    "type": "string"
   },
   "document_kind": {
    "enum": [
     "quote",
     "invoice"
    ],
    "title": "Document Kind",
    "type": "string"
   },
   "mode": {
    "enum": [
     "card",
     "cheque",
     "cash"
    ],
    "title": "Mode",
    "type": "string"
   },
   "reference": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Reference"
   }
  },
  "required": [
   "document_kind",
   "document_id",
   "mode",
   "amount"
  ],
  "title": "AitoManualPaymentCreate",
  "type": "object"
 },
 "AitoMergeRequest": {
  "description": "The card whose tasks are copied onto the addressed one \u2014 and which goes\nto the trash once they are. One id, nothing else: what is copied is the\nwhole task list, in its order, and the handler owns every rule about\nwhich cards may take part.",
  "properties": {
   "source_project_id": {
    "title": "Source Project Id",
    "type": "integer"
   }
  },
  "required": [
   "source_project_id"
  ],
  "title": "AitoMergeRequest",
  "type": "object"
 },
 "AitoNoteCreate": {
  "description": "The ONLY thing a client may append to the timeline.\n\nDeliberately carries no kind, actor or timestamp: the handler fixes all\nthree. A body that could name its own kind could fabricate an acceptance.",
  "properties": {
   "note": {
    "maxLength": 2000,
    "minLength": 1,
    "title": "Note",
    "type": "string"
   }
  },
  "required": [
   "note"
  ],
  "title": "AitoNoteCreate",
  "type": "object"
 },
 "AitoPaymentLinkView": {
  "description": "The project's CURRENT online payment link (services/aito_payment_links.py).\n`state` is Heimdall's unified status. `url` is public \u2014 the payment page\nthe client opens \u2014 so it rides on the board payload like quote_url.",
  "properties": {
   "amount": {
    "title": "Amount",
