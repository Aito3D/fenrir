 "AitoQuoteEmailResponse": {
  "$defs": {
   "AitoPaymentLinkView": {
    "description": "The project's CURRENT online payment link (services/aito_payment_links.py).\n`state` is Heimdall's unified status. `url` is public \u2014 the payment page\nthe client opens \u2014 so it rides on the board payload like quote_url.",
    "properties": {
     "amount": {
      "title": "Amount",
      "type": "integer"
     },
     "currency": {
      "title": "Currency",
      "type": "string"
     },
     "expires_on": {
      "title": "Expires On",
      "type": "string"
     },
     "id": {
      "title": "Id",
      "type": "integer"
     },
     "minted": {
      "title": "Minted",
      "type": "boolean"
     },
     "paid_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Paid At"
     },
     "state": {
      "enum": [
       "pending",
       "paid",
       "failed",
       "cancelled",
       "expired"
      ],
      "title": "State",
      "type": "string"
     },
     "sync_error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Sync Error"
     },
     "url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Url"
     }
