 "AitoTaskReorder": {
  "description": "The complete desired order of one project's tasks. Complete, not a\ndelta: the handler validates it as exactly the current id set, which is\nwhat turns a stale client list (concurrent add/delete) into a 409 instead\nof silent corruption. 300 mirrors AitoProjectCreate's task-list cap.",
  "properties": {
   "task_ids": {
    "items": {
     "type": "integer"
    },
    "maxItems": 300,
    "minItems": 1,
    "title": "Task Ids",
    "type": "array"
   }
  },
  "required": [
   "task_ids"
  ],
  "title": "AitoTaskReorder",
  "type": "object"
 },
