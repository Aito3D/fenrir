 },
 "AitoProjectResponse": {
  "$defs": {
   "AitoPaymentLinkView": {
    "description": "The project's CURRENT online payment link (services/aito_payment_links.py).\n`state` is Heimdall's unified status. `url` is public \u2014 the payment page\nthe client opens \u2014 so it rides on the board payload like quote_url.",
    "properties": {
     "amount": {
      "title": "Amount",
      "type": "integer"
     },
     "currency": {
      "title": "Currency",
      "type": "string"
     },
     "expires_on": {
      "title": "Expires On",
      "type": "string"
     },
     "id": {
      "title": "Id",
      "type": "integer"
     },
     "minted": {
      "title": "Minted",
      "type": "boolean"
     },
     "paid_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Paid At"
     },
     "state": {
      "enum": [
       "pending",
       "paid",
       "failed",
       "cancelled",
       "expired"
      ],
      "title": "State",
      "type": "string"
     },
     "sync_error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Sync Error"
     },
     "url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Url"
     }
    },
    "required": [
     "id",
     "state",
     "amount",
     "currency",
     "url",
     "expires_on",
     "paid_at",
     "sync_error",
     "minted"
    ],
    "title": "AitoPaymentLinkView",
    "type": "object"
   },
   "AitoTaskStepsResponse": {
    "description": "One task's steps, for the board card's per-task rows.\n\nMirrors TaskSteps in services/aito_board_rules.py. Both lists are in\ncanonical SERVICES order; `done` is a subset of `services`, and a service\npriced None appears in neither \u2014 it is absent from the job, not pending.\n`title` is the task's own name, \"\" when it has none \u2014 the frontend\nsupplies the fallback name (\"Task N\") for that case.",
    "properties": {
     "done": {
      "items": {
       "type": "string"
      },
      "title": "Done",
      "type": "array"
     },
     "services": {
      "items": {
       "type": "string"
      },
      "title": "Services",
      "type": "array"
     },
     "title": {
      "default": "",
      "title": "Title",
      "type": "string"
     }
    },
    "required": [
     "services",
     "done"
    ],
    "title": "AitoTaskStepsResponse",
    "type": "object"
   },
   "AitoTerminalPaymentView": {
    "description": "The project's most recent Heimdall terminal (card) charge \u2014\nservices/aito_terminal_payments.py's `terminal_view`. Unlike\n`AitoPaymentLinkView` this is never \"current and open only\": once a card\ncharge exists it rides on the project until superseded by a newer one, so\nthe panel can show a settled/failed attempt instead of nothing.",
    "properties": {
     "amount": {
      "title": "Amount",
      "type": "integer"
     },
     "amount_confirmed": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Amount Confirmed"
     },
     "booking_error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Booking Error"
     },
     "booking_status": {
      "anyOf": [
       {
        "enum": [
         "pending",
         "booked",
         "failed",
         "not_booked"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Booking Status"
     },
     "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
     },
     "document_kind": {
      "enum": [
       "quote",
       "invoice"
      ],
      "title": "Document Kind",
      "type": "string"
     },
     "document_number": {
      "title": "Document Number",
      "type": "string"
     },
     "id": {
      "title": "Id",
      "type": "integer"
     },
     "settled_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Settled At"
     },
     "status": {
      "enum": [
       "pending",
       "processing",
       "paid",
       "failed",
