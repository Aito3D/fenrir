   "model"
  ],
  "title": "AitoPickupMessageResponse",
  "type": "object"
 },
 "AitoPickupSmsRequest": {
  "description": "The message to relay \u2014 the user may have edited the draft, so this is\nwhat actually goes to the phone, not what the model wrote.",
