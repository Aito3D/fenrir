    "type": "object"
   }
  },
  "description": "The send-retainer modal's prefill \u2014 ``AitoInvoiceEmailContent`` for a\nretainer invoice. ``retainer_id`` is echoed back on POST so the send is\npinned to the row the operator saw; the server still owns the candidate\nset and only checks the id for membership.",
  "properties": {
   "body": {
    "title": "Body",
    "type": "string"
   },
   "default_email": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "title": "Default Email"
   },
   "recipients": {
    "items": {
     "$ref": "#/$defs/AitoQuoteEmailRecipient"
    },
    "title": "Recipients",
