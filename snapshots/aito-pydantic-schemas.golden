   "AitoTaskStepsResponse": {
    "description": "One task's steps, for the board card's per-task rows.\n\nMirrors TaskSteps in services/aito_board_rules.py. Both lists are in\ncanonical SERVICES order; `done` is a subset of `services`, and a service\npriced None appears in neither \u2014 it is absent from the job, not pending.\n`title` is the task's own name, \"\" when it has none \u2014 the frontend\nsupplies the fallback name (\"Task N\") for that case.",
    "properties": {
     "done": {
      "items": {
       "type": "string"
      },
      "title": "Done",
      "type": "array"
     },
     "services": {
      "items": {
       "type": "string"
      },
      "title": "Services",
      "type": "array"
     },
     "title": {
      "default": "",
      "title": "Title",
      "type": "string"
     }
    },
    "required": [
     "services",
     "done"
    ],
    "title": "AitoTaskStepsResponse",
    "type": "object"
   },
   "AitoTerminalPaymentView": {
    "description": "The project's most recent Heimdall terminal (card) charge \u2014\nservices/aito_terminal_payments.py's `terminal_view`. Unlike\n`AitoPaymentLinkView` this is never \"current and open only\": once a card\ncharge exists it rides on the project until superseded by a newer one, so\nthe panel can show a settled/failed attempt instead of nothing.",
    "properties": {
     "amount": {
      "title": "Amount",
      "type": "integer"
     },
     "amount_confirmed": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Amount Confirmed"
     },
     "booking_error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Booking Error"
     },
     "booking_status": {
      "anyOf": [
       {
        "enum": [
         "pending",
         "booked",
         "failed",
         "not_booked"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Booking Status"
     },
     "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
     },
     "document_kind": {
      "enum": [
       "quote",
       "invoice"
      ],
      "title": "Document Kind",
      "type": "string"
     },
     "document_number": {
      "title": "Document Number",
      "type": "string"
     },
     "id": {
      "title": "Id",
      "type": "integer"
     },
     "settled_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Settled At"
     },
     "status": {
      "enum": [
       "pending",
       "processing",
       "paid",
       "failed",
       "cancelled",
       "expired",
       "needs_attention"
      ],
      "title": "Status",
      "type": "string"
     },
     "sync_error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Sync Error"
     }
    },
    "required": [
     "id",
     "document_kind",
     "document_number",
     "status",
     "amount",
     "amount_confirmed",
     "booking_status",
     "booking_error",
     "sync_error",
     "created_at",
     "settled_at"
    ],
    "title": "AitoTerminalPaymentView",
    "type": "object"
   }
  },
  "description": "``zoho_synced`` is a transport detail, so it rides alongside the project\nrather than on it: the frontend writes ``project`` straight into the board\ncache with setQueryData, and a cached board row has no business carrying\nthe outcome of one request.",
  "properties": {
   "no_op": {
    "default": false,
    "title": "No Op",
    "type": "boolean"
   },
   "project": {
    "$ref": "#/$defs/AitoProjectResponse"
   },
   "zoho_synced": {
    "title": "Zoho Synced",
    "type": "boolean"
   }
  },
  "required": [
   "project",
   "zoho_synced"
  ],
  "title": "AitoQuoteStatusResponse",
  "type": "object"
 },
 "AitoQuoteStatusUpdate": {
  "description": "The three transitions the board can drive. Zoho has no /status/draft, and\n`viewed` and `expired` are things that happen TO a quote rather than\ndecisions anyone makes \u2014 they only ever arrive from Zoho.",
  "properties": {
   "status": {
    "enum": [
     "sent",
     "accepted",
     "declined"
    ],
    "title": "Status",
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "title": "AitoQuoteStatusUpdate",
  "type": "object"
 },
