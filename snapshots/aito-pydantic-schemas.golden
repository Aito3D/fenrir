 "AitoTaskStepsResponse": {
  "description": "One task's steps, for the board card's per-task rows.\n\nMirrors TaskSteps in services/aito_board_rules.py. Both lists are in\ncanonical SERVICES order; `done` is a subset of `services`, and a service\npriced None appears in neither \u2014 it is absent from the job, not pending.\n`title` is the task's own name, \"\" when it has none \u2014 the frontend\nsupplies the fallback name (\"Task N\") for that case.",
  "properties": {
   "done": {
    "items": {
     "type": "string"
    },
    "title": "Done",
    "type": "array"
   },
   "services": {
    "items": {
     "type": "string"
    },
    "title": "Services",
    "type": "array"
   },
   "title": {
    "default": "",
    "title": "Title",
    "type": "string"
   }
  },
  "required": [
   "services",
   "done"
  ],
  "title": "AitoTaskStepsResponse",
  "type": "object"
 },
 "AitoTaskTransfer": {
  "description": "Tasks leaving this card. `target_project_id` None = split onto a new\ncard for the same client; an id = move onto that card. Ids must be\nunique (a duplicate is a stale client list, 422 here, 409 in the handler\nwhen they are not this card's).",
  "properties": {
   "target_project_id": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Target Project Id"
   },
   "task_ids": {
    "items": {
     "type": "integer"
    },
    "maxItems": 300,
    "minItems": 1,
    "title": "Task Ids",
    "type": "array"
   }
  },
  "required": [
   "task_ids"
  ],
  "title": "AitoTaskTransfer",
  "type": "object"
 },
 "AitoTaskTransferResponse": {
  "$defs": {
   "AitoPaymentLinkView": {
    "description": "The project's CURRENT online payment link (services/aito_payment_links.py).\n`state` is Heimdall's unified status. `url` is public \u2014 the payment page\nthe client opens \u2014 so it rides on the board payload like quote_url.",
    "properties": {
     "amount": {
      "title": "Amount",
      "type": "integer"
     },
     "currency": {
      "title": "Currency",
      "type": "string"
     },
     "expires_on": {
      "title": "Expires On",
      "type": "string"
     },
     "id": {
      "title": "Id",
      "type": "integer"
     },
     "minted": {
      "title": "Minted",
      "type": "boolean"
     },
     "paid_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Paid At"
     },
     "state": {
      "enum": [
       "pending",
       "paid",
       "failed",
       "cancelled",
       "expired"
      ],
      "title": "State",
      "type": "string"
     },
     "sync_error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Sync Error"
     },
     "url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Url"
     }
    },
