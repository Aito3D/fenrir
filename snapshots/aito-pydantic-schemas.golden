   "state",
   "amount",
   "currency",
   "url",
   "expires_on",
   "paid_at",
   "sync_error",
   "minted"
  ],
  "title": "AitoPaymentLinkView",
  "type": "object"
 },
 "AitoPickupMessageResponse": {
  "description": "The AI-drafted \"come and collect\" SMS. A draft, never sent as-is: the\npanel shows it editable and only /pickup-sms sends anything.",
