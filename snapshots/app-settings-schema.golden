    "type": "<class 'str'>"
   },
   "obico_ml_token": {
    "constraints": [],
    "default": "''",
    "description": "Bearer token for the Obico ML API, matching the server's ML_API_TOKEN environment variable. Empty when the server runs without one.",
    "required": false,
    "type": "<class 'str'>"
   },
   "obico_ml_url": {
    "constraints": [],
    "default": "''",
    "description": "Self-hosted Obico ML API base URL (e.g., http://192.168.1.10:3333)",
    "required": false,
    "type": "<class 'str'>"
   },
   "obico_poll_interval": {
    "constraints": [
     "Ge(ge=5)",
     "Le(le=120)"
    ],
    "default": "10",
    "description": "Seconds between detection checks while a print is running",
    "required": false,
    "type": "<class 'int'>"
   },
   "obico_sensitivity": {
    "constraints": [],
    "default": "'medium'",
    "description": "Detection sensitivity: 'low', 'medium', or 'high' (adjusts LOW/HIGH thresholds)",
    "required": false,
    "type": "<class 'str'>"
   },
   "open_in_slicer": {
    "constraints": [],
    "default": "None",
    "description": "Desktop slicer for the 'Open in Slicer' button: 'bambu_studio' or 'orcaslicer'. None inherits from preferred_slicer.",
    "required": false,
    "type": "str | None"
   },
   "openrouter_api_key": {
    "constraints": [],
    "default": "''",
    "description": "OpenRouter API key (write-only)",
    "required": false,
    "type": "<class 'str'>"
   },
   "openrouter_model": {
    "constraints": [],
    "default": "'mistralai/mistral-small'",
    "description": "OpenRouter model id used to generate French project summaries",
    "required": false,
    "type": "<class 'str'>"
   },
   "orcaslicer_api_url": {
    "constraints": [],
    "default": "''",
    "description": "OrcaSlicer sidecar URL (e.g. http://localhost:3003). Empty falls back to the SLICER_API_URL env var.",
    "required": false,
    "type": "<class 'str'>"
   },
   "per_printer_mapping_expanded": {
    "constraints": [],
    "default": "False",
    "description": "Expand custom filament mapping by default in print modal",
    "required": false,
    "type": "<class 'bool'>"
   },
   "pipeline_max_copies": {
    "constraints": [
     "Ge(ge=1)",
     "Le(le=1000)"
    ],
    "default": "50",
    "description": "Upper bound on the copies an operator can request when running a Slicer Pipeline. Larger fleets / production rigs can raise this; the hard ceiling at 1000 is a sanity guard against fat-fingered input.",
    "required": false,
    "type": "<class 'int'>"
   },
   "prefer_lowest_filament": {
    "constraints": [],
    "default": "False",
    "description": "When multiple AMS spools match, prefer the one with lowest remaining filament",
    "required": false,
    "type": "<class 'bool'>"
   },
   "preferred_slicer": {
    "constraints": [],
    "default": "'bambu_studio'",
    "description": "Slicer used for the server-side API / sidecar: 'bambu_studio' or 'orcaslicer'",
    "required": false,
    "type": "<class 'str'>"
   },
   "preheat_enabled": {
    "constraints": [],
    "default": "False",
    "description": "Master toggle / default for new queue items. Per-item preheat_override can flip the decision per print.",
    "required": false,
    "type": "<class 'bool'>"
   },
   "preheat_filament_targets": {
    "constraints": [],
    "default": "''",
    "description": "JSON map of normalized filament type \u2192 chamber target \u00b0C. Empty = bundled defaults (PLA/PETG/TPU/PVA: 0, PETG-CF: 40, ABS/ASA: 45, PA/PC/PC-FR: 50, PA-CF: 55, default: 0). Scheduler picks max across loaded AMS slots; 0 disables chamber phase for that print.",
    "required": false,
    "type": "<class 'str'>"
   },
   "preheat_max_wait_seconds": {
    "constraints": [
     "Ge(ge=60)",
     "Le(le=3600)"
    ],
    "default": "900",
    "description": "Maximum time to wait for the chamber to reach the target before falling through to the soak phase (radiant heating on X1C/P2S can take 15-30 min).",
    "required": false,
    "type": "<class 'int'>"
   },
   "preheat_soak_seconds": {
    "constraints": [
     "Ge(ge=0)",
     "Le(le=1800)"
    ],
    "default": "300",
    "description": "Additional hold time at temperature after the chamber reaches the target (or after max_wait_seconds elapses). 0 = no soak.",
    "required": false,
    "type": "<class 'int'>"
   },
   "print_drying_enabled": {
    "constraints": [],
    "default": "False",
    "description": "Allow auto-drying to also fire on a printer that is currently printing, when its model+firmware supports concurrent drying (H2D 01.03.00.00+, H2C/H2S/P2S/H2D Pro 01.02.00.00+, X2D/A2L 01.01.00.00+, X1C 01.11.02.00+). Drying temperature is automatically capped 5 degC below the idle preset (floor 40 degC) to protect spools during print.",
    "required": false,
    "type": "<class 'bool'>"
   },
   "printer_kill_switch_enabled": {
    "constraints": [],
    "default": "False",
    "description": "Immediately stop printer jobs that start without Bambuddy authorization",
    "required": false,
    "type": "<class 'bool'>"
   },
   "printer_sensor_history_retention_days": {
    "constraints": [],
    "default": "30",
    "description": "Number of days to keep printer heater history data (nozzle / bed / chamber)",
    "required": false,
    "type": "<class 'int'>"
   },
   "prometheus_enabled": {
    "constraints": [],
    "default": "False",
    "description": "Enable Prometheus metrics endpoint at /metrics",
    "required": false,
    "type": "<class 'bool'>"
   },
   "prometheus_token": {
    "constraints": [],
    "default": "''",
    "description": "Bearer token for Prometheus metrics authentication (optional)",
    "required": false,
    "type": "<class 'str'>"
   },
   "pushcut_sms_url": {
    "constraints": [],
    "default": "''",
    "description": "Pushcut SMS notification webhook URL (write-only)",
    "required": false,
    "type": "<class 'str'>"
   },
   "queue_drying_block": {
    "constraints": [],
    "default": "False",
    "description": "Block queue until drying completes (when disabled, prints take priority over drying)",
    "required": false,
    "type": "<class 'bool'>"
   },
   "queue_drying_enabled": {
    "constraints": [],
    "default": "False",
    "description": "Automatically dry AMS filament between queued prints",
    "required": false,
    "type": "<class 'bool'>"
   },
   "queue_keep_bed_warm": {
    "constraints": [],
    "default": "False",
    "description": "While a printer is in FINISH state awaiting plate-clear and the next queued item requires chamber heating, hold the bed hot so the chamber stays warm during the bed-clearing window. The bed is the chamber's heating element here: the hold target is queue_keep_warm_bed_temp, or the item's own bed_temperature when the slicer metadata reports a higher one. Only fires for filaments with a non-zero chamber target (ASA, ABS, PA, PC etc.); PLA/PETG prints are skipped automatically.",
    "required": false,
    "type": "<class 'bool'>"
   },
   "queue_keep_warm_bed_temp": {
    "constraints": [
     "Ge(ge=40)",
     "Le(le=110)"
    ],
    "default": "90",
    "description": "Bed temperature (\u00b0C) used when the bed's job is to heat the chamber. 90 sustains chamber warmth on enclosed printers and satisfies bed-threshold-linked aftermarket chamber heaters (which typically activate at bed \u2265 80). Applies in two places: the keep-warm hold between chamber-heated prints, and preheat when a chamber-heated item's slicer metadata carries no bed temperature at all. A parsed bed temperature higher than this always wins, so the bed is never driven cooler than the print needs.",
    "required": false,
    "type": "<class 'int'>"
   },
   "queue_keep_warm_max_minutes": {
    "constraints": [
     "Ge(ge=5)",
     "Le(le=480)"
    ],
    "default": "120",
    "description": "How long keep-warm may hold the bed on a printer waiting for its plate to be cleared. When this elapses the bed is switched off, and the hold does not re-arm until the printer next becomes a keep-warm candidate \u2014 so a plate nobody clears cannot leave the bed hot indefinitely. Set it to how long you realistically take to reach the printer; the only cost of it being too short is that the next print re-soaks from cold.",
    "required": false,
    "type": "<class 'int'>"
   },
   "queue_max_concurrent_uploads": {
    "constraints": [
     "Ge(ge=1)",
     "Le(le=16)"
    ],
    "default": "4",
    "description": "How many printers the queue may upload to at the same time. Printers are independent machines, so raising this starts a multi-printer batch proportionally sooner; each concurrent upload costs one connection and one thread on the Bambuddy host.",
    "required": false,
    "type": "<class 'int'>"
   },
   "queue_shortest_first": {
    "constraints": [],
    "default": "False",
    "description": "Shortest Job First \u2014 scheduler prioritizes shorter print jobs over longer ones",
    "required": false,
    "type": "<class 'bool'>"
   },
   "require_plate_clear": {
    "constraints": [],
    "default": "False",
    "description": "Require per-printer plate-clear confirmation before starting queued prints on finished printers",
    "required": false,
    "type": "<class 'bool'>"
   },
   "save_thumbnails": {
    "constraints": [],
    "default": "True",
    "description": "Extract and save preview images from 3MF files",
    "required": false,
    "type": "<class 'bool'>"
   },
   "session_max_hours": {
    "constraints": [
     "Ge(ge=1)",
     "Le(le=720)"
    ],
    "default": "24",
    "description": "Maximum session lifetime in hours for user logins (default 24, max 720). Applies to new logins only; already-issued tokens keep their original expiry. Longer sessions reduce automatic logout protection.",
    "required": false,
    "type": "<class 'int'>"
   },
   "slice_engine": {
    "constraints": [],
    "default": "'sidecar'",
    "description": "Default execution site for slicing: 'sidecar' (server-side API) or 'browser'",
    "required": false,
    "type": "<class 'str'>"
   },
   "slicer_stall_timeout_minutes": {
    "constraints": [
     "Ge(ge=1)",
     "Le(le=240)"
    ],
    "default": "15",
    "description": "Give up on a slice after this many minutes with no progress from the sidecar. On sidecars that do not report progress, applies to total slicing time instead.",
    "required": false,
    "type": "<class 'int'>"
   },
   "spoolman_disable_weight_sync": {
    "constraints": [],
    "default": "False",
    "description": "Disable remaining_weight sync. When enabled, only location is updated for existing spools.",
    "required": false,
    "type": "<class 'bool'>"
   },
   "spoolman_enabled": {
    "constraints": [],
    "default": "False",
    "description": "Enable Spoolman integration for filament tracking",
    "required": false,
    "type": "<class 'bool'>"
   },
   "spoolman_report_partial_usage": {
    "constraints": [],
    "default": "True",
    "description": "Report Partial Usage for Failed Prints. When a print fails or is cancelled, report the estimated filament used up to that point based on layer progress.",
    "required": false,
    "type": "<class 'bool'>"
   },
   "spoolman_sync_mode": {
    "constraints": [],
    "default": "'auto'",
    "description": "Sync mode: 'auto' syncs immediately, 'manual' requires button press",
    "required": false,
    "type": "<class 'str'>"
   },
   "spoolman_url": {
    "constraints": [],
    "default": "''",
    "description": "Spoolman server URL (e.g., http://localhost:7912)",
    "required": false,
    "type": "<class 'str'>"
   },
   "stagger_group_size": {
    "constraints": [
     "Ge(ge=1)",
     "Le(le=50)"
    ],
    "default": "2",
    "description": "Number of printers to start simultaneously in staggered mode",
    "required": false,
    "type": "<class 'int'>"
   },
   "stagger_interval_minutes": {
    "constraints": [
     "Ge(ge=1)",
     "Le(le=60)"
    ],
    "default": "5",
    "description": "Minutes between staggered printer groups",
    "required": false,
    "type": "<class 'int'>"
   },
   "time_format": {
    "constraints": [],
    "default": "'system'",
    "description": "Time format: system, 12h, 24h",
    "required": false,
    "type": "<class 'str'>"
   },
   "use_slicer_api": {
    "constraints": [],
    "default": "False",
    "description": "Use the slicer-API sidecar for slicing instead of the desktop slicer URI scheme",
    "required": false,
    "type": "<class 'bool'>"
   },
   "user_notifications_enabled": {
    "constraints": [],
    "default": "True",
    "description": "Enable user email notifications for print job events (requires Advanced Authentication)",
    "required": false,
    "type": "<class 'bool'>"
   },
   "virtual_printer_access_code": {
    "constraints": [],
    "default": "''",
    "description": "Access code for virtual printer authentication",
    "required": false,
    "type": "<class 'str'>"
   },
   "virtual_printer_archive_name_source": {
    "constraints": [],
    "default": "'metadata'",
    "description": "Source for the archive's display name on virtual-printer uploads: 'metadata' uses the 3MF's embedded print_name (default, matches Bambu's behavior), 'filename' uses the filename Bambu Studio sent over FTP (lets users rename via the slicer's 'send to printer' dialog).",
    "required": false,
    "type": "<class 'str'>"
   },
   "virtual_printer_enabled": {
    "constraints": [],
    "default": "False",
    "description": "Enable virtual printer for slicer uploads",
    "required": false,
    "type": "<class 'bool'>"
   },
   "virtual_printer_mode": {
    "constraints": [],
    "default": "'archive'",
    "description": "Mode: 'archive' (archive now), 'review' (pending review), 'queue' (add to print queue), or 'proxy' (relay to real printer)",
    "required": false,
    "type": "<class 'str'>"
   },
   "zoho_accounts_url": {
    "constraints": [],
    "default": "'https://accounts.zoho.eu'",
    "description": "Zoho accounts (OAuth) URL",
    "required": false,
    "type": "<class 'str'>"
   },
   "zoho_base_url": {
    "constraints": [],
    "default": "'https://www.zohoapis.eu'",
    "description": "Zoho API base URL",
    "required": false,
    "type": "<class 'str'>"
   },
   "zoho_client_id": {
    "constraints": [],
    "default": "''",
    "description": "Zoho OAuth client id",
    "required": false,
    "type": "<class 'str'>"
   },
   "zoho_client_secret": {
    "constraints": [],
    "default": "''",
    "description": "Zoho OAuth client secret (write-only)",
    "required": false,
    "type": "<class 'str'>"
   },
   "zoho_default_contact_id": {
    "constraints": [],
    "default": "'66407000001237340'",
    "description": "Zoho contact used as the default Aito client",
    "required": false,
    "type": "<class 'str'>"
   },
   "zoho_default_contact_name": {
    "constraints": [],
    "default": "'Client de passage'",
    "description": "Display name of the default Aito client",
    "required": false,
    "type": "<class 'str'>"
   },
   "zoho_organization_id": {
    "constraints": [],
    "default": "''",
    "description": "Zoho Books organization id",
    "required": false,
    "type": "<class 'str'>"
   },
   "zoho_refresh_token": {
    "constraints": [],
    "default": "''",
    "description": "Zoho OAuth refresh token (write-only)",
    "required": false,
    "type": "<class 'str'>"
   }
  },
  "validators": {
   "field_validators": {},
   "model_validators": []
  }
 },
