CREATE TABLE aito_task_deliveries (
	task_id INTEGER NOT NULL, 
	revision_id INTEGER NOT NULL, 
	created_by_id INTEGER, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (task_id, revision_id), 
	FOREIGN KEY(created_by_id) REFERENCES users (id) ON DELETE SET NULL
);
CREATE INDEX ix_aito_task_deliveries_revision_id ON aito_task_deliveries (revision_id);
CREATE TABLE aito_tasks (
	id INTEGER NOT NULL, 
	project_id INTEGER NOT NULL, 
	linked_project_id INTEGER, 
	position INTEGER NOT NULL, 
	title VARCHAR(200), 
	scan_cost FLOAT, 
	modelisation_cost FLOAT, 
	usinage_cost FLOAT, 
	maindoeuvre_cost FLOAT, 
	scan_quantity INTEGER, 
	modelisation_quantity INTEGER, 
	usinage_quantity INTEGER, 
	scan_discount_pct FLOAT, 
	modelisation_discount_pct FLOAT, 
	usinage_discount_pct FLOAT, 
	impression_printer_id INTEGER, 
	impression_filament_id INTEGER, 
	impression_weight_g FLOAT, 
	impression_time_min INTEGER, 
	impression_quantity INTEGER, 
	impression_color VARCHAR(100), 
	impression_cost FLOAT, 
	impression_discount_pct FLOAT, 
	scan_description TEXT, 
	modelisation_description TEXT, 
	impression_description TEXT, 
	usinage_description TEXT, 
	maindoeuvre_description TEXT, 
	scan_done BOOLEAN DEFAULT '0' NOT NULL, 
	modelisation_done BOOLEAN DEFAULT '0' NOT NULL, 
	impression_done BOOLEAN DEFAULT '0' NOT NULL, 
	usinage_done BOOLEAN DEFAULT '0' NOT NULL, 
	maindoeuvre_done BOOLEAN DEFAULT '0' NOT NULL, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	updated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id)
);
CREATE INDEX ix_aito_tasks_linked_project_id ON aito_tasks (linked_project_id);
CREATE INDEX ix_aito_tasks_project_id ON aito_tasks (project_id);
CREATE TABLE library_files (
	id INTEGER NOT NULL, 
	folder_id INTEGER, 
	project_id INTEGER, 
	is_external BOOLEAN NOT NULL, 
	filename VARCHAR(255) NOT NULL, 
	file_path VARCHAR(500) NOT NULL, 
	file_type VARCHAR(10) NOT NULL, 
	file_size INTEGER NOT NULL, 
	file_hash VARCHAR(64), 
	thumbnail_path VARCHAR(500), 
	file_metadata JSON, 
	print_count INTEGER NOT NULL, 
	last_printed_at DATETIME, 
	notes TEXT, 
	external_url VARCHAR(500), 
	photos JSON, 
	source_type VARCHAR(32), 
	source_url VARCHAR(512), 
	variant_group_id INTEGER, 
	variant_position INTEGER DEFAULT '0' NOT NULL, 
	variant_target_model VARCHAR(50), 
	created_by_id INTEGER, 
	revision_id INTEGER, 
	deleted_at DATETIME, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	updated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	fs_modified_at DATETIME, 
	PRIMARY KEY (id), 
	FOREIGN KEY(folder_id) REFERENCES library_folders (id) ON DELETE CASCADE, 
	FOREIGN KEY(project_id) REFERENCES projects (id) ON DELETE SET NULL, 
	FOREIGN KEY(variant_group_id) REFERENCES file_variant_groups (id) ON DELETE SET NULL, 
	FOREIGN KEY(created_by_id) REFERENCES users (id) ON DELETE SET NULL, 
	FOREIGN KEY(revision_id) REFERENCES project_revisions (id) ON DELETE SET NULL
);
CREATE INDEX ix_library_files_deleted_at ON library_files (deleted_at);
CREATE INDEX ix_library_files_revision_id ON library_files (revision_id);
CREATE INDEX ix_library_files_source_url ON library_files (source_url);
CREATE INDEX ix_library_files_variant_group_id ON library_files (variant_group_id);
CREATE TABLE print_queue (
	id INTEGER NOT NULL, 
	printer_id INTEGER, 
	target_model VARCHAR(50), 
	target_location VARCHAR(100), 
	required_filament_types TEXT, 
	waiting_reason TEXT, 
	archive_id INTEGER, 
	library_file_id INTEGER, 
	cost_center_id INTEGER, 
	estimated_cost FLOAT, 
	billing_run_id VARCHAR(36), 
	project_id INTEGER, 
	batch_id INTEGER, 
	revision_id INTEGER, 
	aito_task_id INTEGER, 
	position INTEGER NOT NULL, 
	scheduled_time DATETIME, 
	manual_start BOOLEAN NOT NULL, 
	require_previous_success BOOLEAN NOT NULL, 
	auto_off_after BOOLEAN NOT NULL, 
	ams_mapping TEXT, 
	filament_overrides TEXT, 
	plate_id INTEGER, 
	print_time_seconds INTEGER, 
	been_jumped BOOLEAN NOT NULL, 
	gcode_injection BOOLEAN NOT NULL, 
	dispatch_attempts INTEGER DEFAULT '0' NOT NULL, 
	nozzle_mapping TEXT, 
	nozzles_info TEXT, 
	nozzle_rack_choice TEXT, 
	cleanup_library_after_dispatch BOOLEAN NOT NULL, 
	bed_levelling VARCHAR(8) NOT NULL, 
	flow_cali VARCHAR(8) NOT NULL, 
	vibration_cali BOOLEAN NOT NULL, 
	layer_inspect BOOLEAN NOT NULL, 
	timelapse BOOLEAN NOT NULL, 
	use_ams BOOLEAN NOT NULL, 
	nozzle_offset_cali VARCHAR(8) NOT NULL, 
	confirm_outcome BOOLEAN DEFAULT '0' NOT NULL, 
	preheat_override VARCHAR(10) NOT NULL, 
	preheat_chamber_target_override INTEGER, 
	status VARCHAR(20) NOT NULL, 
	dispatching_at DATETIME, 
	gate_acknowledged BOOLEAN NOT NULL, 
	filament_short BOOLEAN NOT NULL, 
	skip_filament_check BOOLEAN NOT NULL, 
	started_at DATETIME, 
	completed_at DATETIME, 
	error_message TEXT, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	created_by_id INTEGER, 
	PRIMARY KEY (id), 
	FOREIGN KEY(printer_id) REFERENCES printers (id) ON DELETE CASCADE, 
	FOREIGN KEY(archive_id) REFERENCES print_archives (id) ON DELETE CASCADE, 
	FOREIGN KEY(library_file_id) REFERENCES library_files (id) ON DELETE CASCADE, 
	FOREIGN KEY(cost_center_id) REFERENCES cost_centers (id) ON DELETE SET NULL, 
	FOREIGN KEY(project_id) REFERENCES projects (id) ON DELETE SET NULL, 
	FOREIGN KEY(batch_id) REFERENCES print_batches (id) ON DELETE SET NULL, 
	FOREIGN KEY(created_by_id) REFERENCES users (id) ON DELETE SET NULL
);
CREATE INDEX ix_print_queue_aito_task_id ON print_queue (aito_task_id);
CREATE INDEX ix_print_queue_revision_id ON print_queue (revision_id);
CREATE TABLE project_bom_items (
	id INTEGER NOT NULL, 
	project_id INTEGER NOT NULL, 
	name VARCHAR(255) NOT NULL, 
	quantity_needed INTEGER NOT NULL, 
	quantity_acquired INTEGER NOT NULL, 
	unit_price FLOAT, 
	sourcing_url VARCHAR(512), 
	archive_id INTEGER, 
	stl_filename VARCHAR(255), 
	remarks TEXT, 
	sort_order INTEGER NOT NULL, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	updated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id), 
	FOREIGN KEY(project_id) REFERENCES projects (id) ON DELETE CASCADE, 
	FOREIGN KEY(archive_id) REFERENCES print_archives (id) ON DELETE SET NULL
);
CREATE TABLE project_items (
	id INTEGER NOT NULL, 
	project_id INTEGER NOT NULL, 
	section VARCHAR(16) NOT NULL, 
	name VARCHAR(255) NOT NULL, 
	name_key VARCHAR(255) NOT NULL, 
	last_revision_number INTEGER DEFAULT '0' NOT NULL, 
	forked_from_revision_id INTEGER, 
	position INTEGER DEFAULT '0' NOT NULL, 
	created_by_id INTEGER, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	updated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id), 
	CONSTRAINT uq_project_items_section_name UNIQUE (project_id, section, name_key), 
	FOREIGN KEY(project_id) REFERENCES projects (id) ON DELETE CASCADE, 
	CONSTRAINT fk_project_items_forked_from FOREIGN KEY(forked_from_revision_id) REFERENCES project_revisions (id) ON DELETE SET NULL, 
	FOREIGN KEY(created_by_id) REFERENCES users (id) ON DELETE SET NULL
);
CREATE INDEX ix_project_items_project_id ON project_items (project_id);
CREATE TABLE project_revisions (
	id INTEGER NOT NULL, 
	item_id INTEGER NOT NULL, 
	number INTEGER NOT NULL, 
	status VARCHAR(16) DEFAULT 'wip' NOT NULL, 
	note TEXT, 
	derived_from_id INTEGER, 
	config_snapshot JSON, 
	config_hash VARCHAR(64), 
	slicer_name VARCHAR(64), 
	slicer_version VARCHAR(64), 
	print_profile JSON, 
	pipeline_id INTEGER, 
	pipeline_name VARCHAR(200), 
	status_changed_by_id INTEGER, 
	status_changed_at DATETIME, 
	created_by_id INTEGER, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id), 
	CONSTRAINT uq_project_revisions_item_number UNIQUE (item_id, number), 
	FOREIGN KEY(item_id) REFERENCES project_items (id) ON DELETE CASCADE, 
	FOREIGN KEY(derived_from_id) REFERENCES project_revisions (id) ON DELETE SET NULL, 
	FOREIGN KEY(status_changed_by_id) REFERENCES users (id) ON DELETE SET NULL, 
	FOREIGN KEY(created_by_id) REFERENCES users (id) ON DELETE SET NULL
);
CREATE INDEX ix_project_revisions_derived_from_id ON project_revisions (derived_from_id);
CREATE INDEX ix_project_revisions_item_id ON project_revisions (item_id);
CREATE INDEX ix_project_revisions_status ON project_revisions (status);
CREATE TABLE project_tags (
	project_id INTEGER NOT NULL, 
	tag_id INTEGER NOT NULL, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (project_id, tag_id), 
	FOREIGN KEY(project_id) REFERENCES projects (id) ON DELETE CASCADE, 
	FOREIGN KEY(tag_id) REFERENCES library_tags (id) ON DELETE CASCADE
);
CREATE INDEX ix_project_tags_tag_id ON project_tags (tag_id);
CREATE TABLE projects (
	id INTEGER NOT NULL, 
	name VARCHAR(255) NOT NULL, 
	code VARCHAR(16), 
	storage_dir VARCHAR(255), 
	legacy_migrated_at DATETIME, 
	description TEXT, 
	color VARCHAR(20), 
	status VARCHAR(20) NOT NULL, 
	url VARCHAR(2048), 
	cover_image_filename VARCHAR(255), 
	target_count INTEGER, 
	target_parts_count INTEGER, 
	target_sets INTEGER, 
	notes TEXT, 
	attachments JSON, 
	tags TEXT, 
	due_date DATETIME, 
	priority VARCHAR(20) NOT NULL, 
	budget FLOAT, 
	is_template BOOLEAN NOT NULL, 
	template_source_id INTEGER, 
	parent_id INTEGER, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	updated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id), 
	FOREIGN KEY(parent_id) REFERENCES projects (id)
);
CREATE UNIQUE INDEX ix_projects_code ON projects (code);

