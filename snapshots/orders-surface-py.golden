=== ddl
-- sqlite
CREATE TABLE order_board_docs (
	id INTEGER NOT NULL, 
	kind VARCHAR(20) NOT NULL, 
	zoho_id VARCHAR(64) NOT NULL, 
	header JSON NOT NULL, 
	detail JSON, 
	pending BOOLEAN NOT NULL, 
	PRIMARY KEY (id), 
	CONSTRAINT uq_order_board_docs_kind_zoho_id UNIQUE (kind, zoho_id)
);
-- postgresql
CREATE TABLE order_board_docs (
	id SERIAL NOT NULL, 
	kind VARCHAR(20) NOT NULL, 
	zoho_id VARCHAR(64) NOT NULL, 
	header JSON NOT NULL, 
	detail JSON, 
	pending BOOLEAN NOT NULL, 
	PRIMARY KEY (id), 
	CONSTRAINT uq_order_board_docs_kind_zoho_id UNIQUE (kind, zoho_id)
);

-- sqlite
CREATE TABLE order_board_events (
	id INTEGER NOT NULL, 
	salesorder_id VARCHAR(64) NOT NULL, 
	occurred_at DATETIME NOT NULL, 
	kind VARCHAR(48) NOT NULL, 
	actor_class VARCHAR(16) NOT NULL, 
	actor_name VARCHAR(255), 
	changes JSON, 
	detail JSON, 
	note TEXT, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, 
	PRIMARY KEY (id)
);
CREATE INDEX ix_order_board_events_kind ON order_board_events (kind);
CREATE INDEX ix_order_board_events_occurred_at ON order_board_events (occurred_at);
CREATE INDEX ix_order_board_events_so_occurred ON order_board_events (salesorder_id, occurred_at, id);
-- postgresql
CREATE TABLE order_board_events (
	id SERIAL NOT NULL, 
	salesorder_id VARCHAR(64) NOT NULL, 
	occurred_at TIMESTAMP WITHOUT TIME ZONE NOT NULL, 
	kind VARCHAR(48) NOT NULL, 
	actor_class VARCHAR(16) NOT NULL, 
	actor_name VARCHAR(255), 
	changes JSON, 
	detail JSON, 
	note TEXT, 
	created_at TIMESTAMP WITHOUT TIME ZONE DEFAULT now() NOT NULL, 
	PRIMARY KEY (id)
);
CREATE INDEX ix_order_board_events_kind ON order_board_events (kind);
CREATE INDEX ix_order_board_events_occurred_at ON order_board_events (occurred_at);
CREATE INDEX ix_order_board_events_so_occurred ON order_board_events (salesorder_id, occurred_at, id);

