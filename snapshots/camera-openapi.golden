### exit: 0
### stdout:
{
 "/api/v1/printers/camera/grid-stream": {
  "get": {
   "description": "Multiplexed camera stream for the camera grid.\n\nStreams JPEG frames for multiple printers over a SINGLE HTTP connection\nusing a binary framing protocol.  This avoids the browser's\n6-connection-per-origin limit that makes the page unresponsive when many\ncameras are open.\n\nBinary frame format (little-endian):\n    [4 bytes: printer_id][4 bytes: jpeg_length][jpeg_data]\n\nThe frontend reads this stream with one fetch() and demuxes frames to\nthe correct <canvas> element by printer ID.",
   "operationId": "camera_grid_stream_api_v1_printers_camera_grid_stream_get",
   "parameters": [
    {
     "description": "Comma-separated printer IDs",
     "in": "query",
     "name": "ids",
     "required": true,
     "schema": {
      "description": "Comma-separated printer IDs",
      "maxLength": 500,
      "title": "Ids",
      "type": "string"
     }
    },
    {
     "in": "query",
     "name": "fps",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "maximum": 30,
        "minimum": 1,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Fps"
     }
    },
    {
     "in": "query",
     "name": "quality",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "maximum": 31,
        "minimum": 2,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Quality"
     }
    },
    {
     "in": "query",
     "name": "scale",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "maximum": 1.0,
        "minimum": 0.1,
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Scale"
     }
    },
    {
     "description": "Force restart producers with new quality settings",
     "in": "query",
     "name": "force",
     "required": false,
     "schema": {
      "default": false,
      "description": "Force restart producers with new quality settings",
      "title": "Force",
      "type": "boolean"
     }
    },
    {
     "in": "header",
     "name": "X-API-Key",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "X-Api-Key"
     }
    }
   ],
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {}
      }
     },
     "description": "Successful Response"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/HTTPValidationError"
       }
      }
     },
     "description": "Validation Error"
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ],
   "summary": "Camera Grid Stream",
   "tags": [
    "camera"
   ]
  }
 },
