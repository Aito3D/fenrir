 "/api/v1/printers/{printer_id}/camera/check-plate": {
  "get": {
   "description": "Check if the build plate is empty using camera vision.\n\nUses calibration-based difference detection - compares current frame\nto a reference image of the empty plate.\n\nIMPORTANT: Chamber light must be ON for reliable detection.\n\nArgs:\n    printer_id: Printer ID\n    plate_type: Type of build plate (e.g., \"High Temp Plate\") for calibration lookup\n    use_external: If True, prefer external camera over built-in. When omitted\n        (None), defaults to the printer's external_camera_enabled setting \u2014\n        mirroring the runtime auto-check at print start (main.py). Without\n        this default the UI's manual check would always use the built-in\n        camera, mismatching the reference saved during calibration (#1359).\n    include_debug_image: If True, return URL to annotated debug image\n\nReturns:\n    Dict with detection results:\n    - is_empty: bool - Whether plate appears empty\n    - confidence: float - Confidence level (0.0 to 1.0)\n    - difference_percent: float - How different from calibration reference\n    - message: str - Human-readable result message\n    - needs_calibration: bool - True if calibration is required\n    - light_warning: bool - True if chamber light is off",
   "operationId": "check_plate_empty_api_v1_printers__printer_id__camera_check_plate_get",
   "parameters": [
    {
     "in": "path",
     "name": "printer_id",
     "required": true,
     "schema": {
      "title": "Printer Id",
      "type": "integer"
     }
    },
    {
     "in": "query",
     "name": "plate_type",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Plate Type"
     }
    },
    {
     "in": "query",
     "name": "use_external",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Use External"
     }
    },
    {
     "in": "query",
     "name": "include_debug_image",
     "required": false,
     "schema": {
      "default": false,
      "title": "Include Debug Image",
      "type": "boolean"
     }
    },
    {
     "in": "header",
     "name": "X-API-Key",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "X-Api-Key"
     }
    }
   ],
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {}
      }
     },
     "description": "Successful Response"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/HTTPValidationError"
       }
      }
     },
     "description": "Validation Error"
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ],
   "summary": "Check Plate Empty",
   "tags": [
    "camera"
   ]
  }
 },
