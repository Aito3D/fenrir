export interface HourMachine {
  id: number;
  printer_id: number | null;
  name: string;
  model: string | null;
  retired: boolean;
  current_hours: number | null;
  trust: 'calibrated' | 'drifting' | 'uncalibrated' | null;
  last_drift_hours: number | null;
  calibrated_at: string | null; // ISO datetime
  counter_raw_hours: number | null;
  next_service_hours: number | null;
  purchase_price: number | null;
  purchase_date: string | null; // YYYY-MM-DD
  added_on: string | null; // YYYY-MM-DD
}

export interface HourReading {
  id: number;
  machine_id: number;
  reading_date: string; // YYYY-MM-DD
  hours: number;
  source: 'manual' | 'auto';
  raw_hours: number | null;
}

export interface HourEvent {
  id: number;
  machine_id: number;
  event_date: string; // YYYY-MM-DD
  kind: 'note' | 'maintenance' | 'added' | 'retired' | 'calibrated';
  label: string;
  source_id: number | null;
}

export interface HoursOverview {
  today: string; // the server's date
  machines: HourMachine[];
  readings: HourReading[];
  events: HourEvent[];
  reading_interval_days: number;
  due_machine_ids: number[];
}

export interface HourMachineUpdate {
  name?: string;
  model?: string | null;
  purchase_price?: number | null;
  purchase_date?: string | null;
}

export interface HourImportBody {
  new_machines: { key: string; name: string; model: string | null }[];
  readings: { machine_id?: number; key?: string; reading_date: string; hours: number }[];
}

  setPrinterHours: (printerId: number, totalHours: number) =>
    request<{ printer_id: number; total_hours: number; archive_hours: number; offset_hours: number }>(
      `/maintenance/printers/${printerId}/hours?total_hours=${totalHours}`,
      { method: 'PATCH' }
    ),
  getPrinterHours: () => request<HoursOverview>('/maintenance/hours'),
  saveHourReadings: (readingDate: string, entries: { machine_id: number; hours: number | null }[]) =>
    request<HoursOverview>('/maintenance/hours/readings', {
      method: 'POST',
      body: JSON.stringify({ reading_date: readingDate, entries }),
    }),
  deleteHourReadings: (readingDate: string) =>
    request<HoursOverview>(`/maintenance/hours/readings?reading_date=${encodeURIComponent(readingDate)}`, {
      method: 'DELETE',
    }),
  importHourReadings: (body: HourImportBody) =>
    request<{ machines_created: number; readings_written: number }>('/maintenance/hours/import', {
      method: 'POST',
      body: JSON.stringify(body),
    }),
  deleteHourMachine: (machineId: number) =>
    request<{ status: string }>(`/maintenance/hours/machines/${machineId}`, { method: 'DELETE' }),
  createHourEvent: (machineId: number, body: { event_date: string; label: string }) =>
    request<HourEvent>(`/maintenance/hours/machines/${machineId}/events`, {
      method: 'POST',
      body: JSON.stringify(body),
    }),
  deleteHourEvent: (eventId: number) =>
    request<void>(`/maintenance/hours/events/${eventId}`, { method: 'DELETE' }),
  updateHourSettings: (body: { reading_interval_days: number }) =>
    request<HoursOverview>('/maintenance/hours/settings', {
      method: 'PATCH',
      body: JSON.stringify(body),
    }),
  updateHourMachine: (machineId: number, body: HourMachineUpdate) =>
    request<HourMachine>(`/maintenance/hours/machines/${machineId}`, {
      method: 'PATCH',
      body: JSON.stringify(body),
    }),

