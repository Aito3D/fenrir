     "filename",
     "target_model",
     "position"
    ],
    "title": "QueueVariantSummary",
    "type": "object"
   }
  },
  "description": "One page of the queue history, plus what the page needs around it.\n\n``items`` holds the page in display order, followed by any other history\nruns of the batches on that page, so a batch row can count all of its runs.",
  "properties": {
   "items": {
    "items": {
     "$ref": "#/$defs/PrintQueueItemResponse"
    },
    "title": "Items",
    "type": "array"
   },
   "locations": {
    "items": {
     "type": "string"
    },
    "title": "Locations",
    "type": "array"
   },
   "total": {
    "title": "Total",
    "type": "integer"
   }
  },
  "required": [
   "items",
   "total",
   "locations"
  ],
  "title": "PrintQueueHistoryResponse",
  "type": "object"
 },
 "PrintQueueItemCreate": {
  "$defs": {
   "QueueVariantCreate": {
    "description": "One candidate file for a cross-model queue item (#671).\n\nPer-file rather than per-item because the settings genuinely differ between\ncandidates: an H2C slice is dual-nozzle and will not share slot count, AMS\nmapping or nozzle mapping with the H2S slice of the same model.\n\n``target_model`` is normally omitted and read from the file's own\n``sliced_for_model``; supply it only for a legacy 3MF that declares none.",
    "properties": {
     "ams_mapping": {
      "anyOf": [
       {
        "items": {
         "type": "integer"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Ams Mapping"
     },
     "filament_overrides": {
      "anyOf": [
       {
        "items": {
         "additionalProperties": true,
         "type": "object"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Filament Overrides"
     },
     "library_file_id": {
      "title": "Library File Id",
      "type": "integer"
     },
     "nozzle_mapping": {
      "anyOf": [
       {
        "items": {
         "type": "integer"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Nozzle Mapping"
     },
     "nozzle_rack_choice": {
      "anyOf": [
       {
        "additionalProperties": {
         "type": "integer"
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Nozzle Rack Choice"
     },
     "plate_id": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Plate Id"
     },
     "target_model": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Target Model"
     }
    },
    "required": [
     "library_file_id"
    ],
    "title": "QueueVariantCreate",
    "type": "object"
   }
  },
