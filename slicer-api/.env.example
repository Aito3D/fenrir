# Copy to .env and tweak. Defaults match what Fenrir expects out of the box.

# Host ports. Fenrir's virtual-printer feature already binds 3000 and
# 3002, so the OrcaSlicer sidecar sits on 3003. Move them if you run
# this stack on a different host or want to free those ports for VPs.
ORCA_API_PORT=3003
BAMBU_API_PORT=3001

# Sidecar image tag. Default is `latest` (current stable release).
# Pinning options:
#   fenrir-X.Y.Z   pin to the sidecar image that shipped with Fenrir X.Y.Z
#                    (e.g. SIDECAR_TAG=fenrir-0.2.5)
#   daily            track the fenrir:daily channel
SIDECAR_TAG=latest

# Largest model file the sidecars will accept for a slice, in megabytes.
# Raise it if a big multi-colour project is rejected as "too large" -- the
# cap is enforced inside the sidecar, so no reverse-proxy body limit affects
# it. Leave it unset for the 512 MB default.
#MAX_MODEL_UPLOAD_MB=512
